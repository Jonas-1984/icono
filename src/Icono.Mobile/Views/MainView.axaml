<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Icono.Mobile.Views"
             x:Class="Icono.Mobile.Views.MainView"
             Background="{DynamicResource CanvasSurroundBrush}">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- top bar: thin, in three groups; icon (and name) on every key -->
            <Border Grid.Row="0" Padding="10,4" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource BarGradient}">
                
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- the logo on a light plate, like the app icon: its fine blue lines get lost on the dark bar -->
                    <Border Grid.Column="0" x:Name="LogoPlate" Background="#FFF1F5FB" CornerRadius="8" Padding="7,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            Cursor="Hand" ToolTip.Tip="About icono">
                        <Image Source="avares://Icono.Mobile/Assets/icono.png" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>

                    <TextBlock Grid.Column="1" x:Name="TitleText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0"
                               Foreground="{DynamicResource ForegroundTextBrush}" TextTrimming="CharacterEllipsis" Text="Untitled" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <!-- the file -->
                        <Border Classes="barGroup">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="bar" Click="OnNew" ToolTip.Tip="New drawing">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M12 18v-6 M9 15h6" />
                                        <TextBlock Text="New" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="bar" Click="OnOpen" ToolTip.Tip="Open a drawing">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M6 14l1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="bar" Click="OnSave" ToolTip.Tip="Save">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7 M7 3v4a1 1 0 0 0 1 1h7" />
                                        <TextBlock Text="Save" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="bar" Click="OnSaveAs" ToolTip.Tip="Save under another name">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M4 4h13l3 3v13H4z M8 4v5h8 M8 20v-6h8v6" />
                                        <TextBlock Text="Save as" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="bar" Click="OnExport" ToolTip.Tip="Export as PDF or PNG">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M12 15V3 M7 8l5-5 5 5 M5 21h14" />
                                        <TextBlock Text="Export" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="bar" Click="OnInsertPicture" ToolTip.Tip="Insert a picture or an SVG">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8.5 8.5h.01 M21 15l-5-5L5 21" />
                                        <TextBlock Text="Picture" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- editing: icons only -->
                        <Border Classes="barGroup">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="bar icon" x:Name="UndoButton" Click="OnUndo" ToolTip.Tip="Undo">
                                    <Path Classes="barIcon" Data="M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
                                </Button>
                                <Button Classes="bar icon" x:Name="RedoButton" Click="OnRedo" ToolTip.Tip="Redo">
                                    <Path Classes="barIcon" Data="M15 14l5-5-5-5 M20 9H9.5a5.5 5.5 0 0 0 0 11H13" />
                                </Button>
                                <Button Classes="bar icon" x:Name="DuplicateButton" Click="OnDuplicate" ToolTip.Tip="Duplicate">
                                    <Path Classes="barIcon" Data="M9 9h11a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V10a1 1 0 0 1 1-1z M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
                                </Button>
                                <Button Classes="bar icon" x:Name="DeleteButton" Click="OnDelete" ToolTip.Tip="Delete">
                                    <Path Classes="barIcon" Data="M3 6h18 M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- the view and the settings -->
                        <Border Classes="barGroup">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="bar icon" Click="OnHelp" ToolTip.Tip="Help: the gestures and tools in short">
                                    <Path Classes="barIcon" Data="M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 Z M9.09 9 a3 3 0 0 1 5.83 1 c0 2-3 3-3 3 M12 17 h.01" />
                                </Button>
                                <Button Classes="bar icon" Click="OnFit" ToolTip.Tip="Fit the page to the screen">
                                    <Path Classes="barIcon" Data="M8 3H5a2 2 0 0 0-2 2v3 M21 8V5a2 2 0 0 0-2-2h-3 M3 16v3a2 2 0 0 0 2 2h3 M16 21h3a2 2 0 0 0 2-2v-3" />
                                </Button>
                                <Button Classes="bar" Click="OnPageSettings" ToolTip.Tip="Page size, unit, scale, rulers, sheet, background">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0z M14.5 12.5l2-2 M11.5 9.5l2-2 M8.5 6.5l2-2 M17.5 15.5l2-2" />
                                        <TextBlock Text="Page" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="bar on" x:Name="PropertiesButton" Click="OnToggleProperties" ToolTip.Tip="Show or hide the properties">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Path Classes="barIcon" Data="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6" />
                                        <TextBlock Text="Properties" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                <!-- the tools (filled in MainView.Tools.cs): a soft plate -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="5,5,0,5">
                    <Border CornerRadius="14" BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" ClipToBounds="True" Background="{DynamicResource BarGradient}">
                        
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="ToolPanel" Margin="3,5" Spacing="1" />
                        </ScrollViewer>
                    </Border>
                </Border>

                <!-- the drawing -->
                <views:DocumentCanvas Grid.Column="1" x:Name="Canvas" ClipToBounds="True" />

                <!-- where small pads open: placed at the spot they are about (the corner of the Curve tool) -->
                <Border Grid.Column="1" x:Name="PadAnchor" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

                <!-- the object library (Objects in the tool bar) lies over the left of the drawing -->
                <Border Grid.Column="1" x:Name="LibraryPane" IsVisible="False" Width="300" HorizontalAlignment="Left"
                        Background="{DynamicResource FloatBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,1,0">
                    <views:ObjectLibrary x:Name="Library" />
                </Border>

                <!-- while a wall, polyline or dimension is drawn -->
                <Border Grid.Column="1" x:Name="PathBar" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"
                        Background="{DynamicResource FloatBrush}" CornerRadius="12" Padding="10,6"
                        BorderBrush="{DynamicResource RaisedPressedBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="PathBarText" VerticalAlignment="Center" FontSize="13" Margin="4,0,10,0"
                                   Foreground="{DynamicResource ForegroundTextBrush}" />
                        <Button Classes="tool" x:Name="PathLengthButton" Content="Length..." Click="OnPathLength" IsVisible="False" />
                        <Button Classes="tool" x:Name="PathCloseButton" Content="Close shape" Click="OnPathClose" IsVisible="False" ToolTip.Tip="Join the last point with the first: a closed shape (a room for a wall). Tapping the first point does the same." />
                        <Button Classes="tool" x:Name="PathArcButton" Content="Arc" Click="OnPathArc" IsVisible="False" ToolTip.Tip="Draw the next side as an arc: tap a point on the arc, then its end point. Tap again to draw straight sides." />
                        <Button Classes="tool" x:Name="PathUndoButton" Content="Undo point" Click="OnPathUndoPoint" />
                        <Button Classes="tool" Content="Cancel" Click="OnPathCancel" />
                        <Button Classes="tool primary" x:Name="PathDoneButton" Content="Done" Click="OnPathDone" />
                    </StackPanel>
                </Border>


                <!-- handwriting to text: offered while there is writing of the pen (MainView.Ink.cs) -->
                <Border Grid.Column="1" x:Name="InkBar" Classes="dialog" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,34,0,0" Padding="10,6" CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="InkText" VerticalAlignment="Center" FontSize="13" Margin="4,0,8,0" Foreground="{DynamicResource ForegroundTextBrush}" />
                        <Button Classes="tool" x:Name="InkLanguageButton" Click="OnInkLanguage" ToolTip.Tip="The language of the writing" />
                        <Button Classes="tool primary" x:Name="InkConvertButton" Content="Convert to text" Click="OnInkConvert" />
                    </StackPanel>
                </Border>

                <!-- the properties of the selection (Properties in the top bar shows / hides it) -->
                <Border Grid.Column="2" x:Name="PropertiesPane" Width="276" Background="{DynamicResource ToolbarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1,0,0,0">
                    <views:PropertiesPanel x:Name="Properties" />
                </Border>
            </Grid>

            <!-- status line: thin, the tool and the zoom as small pills -->
            <Border Grid.Row="2" Padding="8,2" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource StatusGradient}">
                
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Classes="pill" MinWidth="64">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Path x:Name="ToolIcon" Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                                  Stroke="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ToolNameText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" Text="Select" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" x:Name="StatusText" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Classes="pillKey" x:Name="GridPill" Content="Grid" Click="OnGridPill" ToolTip.Tip="Show the grid: on / off" />
                        <Button Classes="pillKey" x:Name="SnapPill" Content="Snap" Click="OnSnapPill" ToolTip.Tip="Snap to the grid: on / off" />
                        <Button Classes="pillKey" x:Name="OSnapPill" Content="OSnap" Click="OnOSnapPill" ToolTip.Tip="Object snap (end points, middles, centres ...): on / off. The kinds are in the Properties of the page." />
                        <Button Classes="pillKey" x:Name="PagePill" Content="Page 1 / 1" Click="OnPageSettings" ToolTip.Tip="The page in view - tap for the page settings" />
                        <Button Classes="pillKey" x:Name="ScalePill" Content="1:40" Click="OnPageSettings" ToolTip.Tip="The scale of the drawing - tap to change it" />
                        <Button Classes="pillKey" x:Name="ZoomPill" ToolTip.Tip="Zoom: in, out, actual size, fit the page">
                            <TextBlock x:Name="ZoomText" Text="100 %" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- icono's own file window (MainView.Files.cs): the drawings of the chosen folder, a name to save under, and always a Cancel -->
        <Border x:Name="FilesLayer" IsVisible="False" Background="{DynamicResource ScrimBrush}">
            <Border Classes="dialog" Padding="20,16" Width="640" Margin="0,40"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <TextBlock x:Name="FilesTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundTextBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="FilesFolderText" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Button Grid.Column="1" Classes="tool" x:Name="FilesFolderButton" Content="Choose folder..." Click="OnFilesChooseFolder" />
                        </Grid>
                        <Grid x:Name="FilesNameRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Name" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource ForegroundTextBrush}" />
                            <TextBox Grid.Column="1" x:Name="FilesNameBox" FontSize="14" MinHeight="36" />
                            <TextBlock Grid.Column="2" x:Name="FilesExtensionText" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                        <TextBlock x:Name="FilesNote" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Classes="tool" x:Name="FilesSvgButton" Content="SVG code..." Click="OnFilesSvgCode" IsVisible="False" ToolTip.Tip="Paste the code of an SVG (or only its path data) instead of choosing a file" />
                        <Button Classes="tool" Content="Other location..." Click="OnFilesOtherLocation" />
                        <Button Classes="tool" Content="Cancel" Click="OnFilesCancel" />
                        <Button Classes="tool primary" x:Name="FilesActionButton" Content="Save" Click="OnFilesAction" />
                    </StackPanel>

                    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="10" Margin="0,8,0,0" MaxHeight="420">
                        <ScrollViewer>
                            <StackPanel x:Name="FilesList" Margin="6" Spacing="2" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

        <!-- Export as PDF or PNG, saved or shared (MainView.Export.cs) -->
        <Border x:Name="ExportLayer" IsVisible="False" Background="{DynamicResource ScrimBrush}">
            <Border Classes="dialog" Padding="22,18" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Export" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundTextBrush}" />

                    <TextBlock Text="FORMAT" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource MutedTextBrush}" />
                    <UniformGrid Columns="3">
                        <Button Classes="tool" x:Name="ExportPdfButton" Content="PDF" Tag="Pdf" HorizontalAlignment="Stretch" Click="OnExportFormat" ToolTip.Tip="Real paper size, vectors" />
                        <Button Classes="tool" x:Name="ExportPngButton" Content="PNG" Tag="Png" HorizontalAlignment="Stretch" Click="OnExportFormat" ToolTip.Tip="A picture" />
                        <Button Classes="tool" x:Name="ExportSvgButton" Content="SVG" Tag="Svg" HorizontalAlignment="Stretch" Click="OnExportFormat" ToolTip.Tip="Vector graphic" />
                        <Button Classes="tool" x:Name="ExportIcoButton" Content="Icon (.ico)" Tag="Ico" HorizontalAlignment="Stretch" Click="OnExportFormat" ToolTip.Tip="Windows icon with the sizes 16 to 256 px" />
                        <Button Classes="tool" x:Name="ExportSetButton" Content="PNG set (.zip)" Tag="PngSet" HorizontalAlignment="Stretch" Click="OnExportFormat" ToolTip.Tip="Six pictures from 16 to 512 px in one zip file" />
                    </UniformGrid>

                    <TextBlock Text="PAGES" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource MutedTextBrush}" />
                    <UniformGrid Columns="2">
                        <Button Classes="tool" x:Name="ExportCurrentButton" HorizontalAlignment="Stretch" Click="OnExportCurrentPage" />
                        <Button Classes="tool" x:Name="ExportAllButton" HorizontalAlignment="Stretch" Click="OnExportAllPages" />
                    </UniformGrid>

                    <StackPanel x:Name="ExportResolutionPanel" Spacing="10">
                        <TextBlock Text="RESOLUTION" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="0.8" Foreground="{DynamicResource MutedTextBrush}" />
                        <UniformGrid Columns="3">
                            <Button Classes="tool" x:Name="ExportDpi96" Content="96 dpi" HorizontalAlignment="Stretch" Click="OnExportDpi" Tag="96" />
                            <Button Classes="tool" x:Name="ExportDpi150" Content="150 dpi" HorizontalAlignment="Stretch" Click="OnExportDpi" Tag="150" />
                            <Button Classes="tool" x:Name="ExportDpi300" Content="300 dpi" HorizontalAlignment="Stretch" Click="OnExportDpi" Tag="300" />
                        </UniformGrid>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                        <TextBlock Text="With the page background" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundTextBrush}" />
                        <ToggleSwitch Grid.Column="1" x:Name="ExportBackground" IsChecked="True" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" />
                    </Grid>
                    <TextBlock x:Name="ExportInfo" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="tool" Content="Cancel" Click="OnExportCancel" />
                        <Button Classes="tool" x:Name="ExportPrintButton" Content="Print..." Click="OnExportPrint" ToolTip.Tip="Print the page (or all pages) on a printer, or save it as a PDF with the print dialog of the tablet. At 100 % the drawing keeps its scale." />
                        <Button Classes="tool" x:Name="ExportSaveButton" Content="Save..." Click="OnExportSave" />
                        <Button Classes="tool primary" x:Name="ExportShareButton" Content="Share..." Click="OnExportShare" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- the length of the next wall and the way it goes (MainView.TypedWall.cs); at the top, so the on-screen keyboard does not cover it -->
        <Border x:Name="LengthLayer" IsVisible="False" Background="{DynamicResource ScrimLightBrush}">
            <Border Classes="dialog" Padding="18,14" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Next wall" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundTextBrush}" />
                    <TextBox Classes="field" x:Name="LengthEntry" FontSize="15" MinHeight="40" PlaceholderText="Length, e.g. 250 or 2.5 m" />
                    <TextBlock x:Name="LengthNote" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                               Text="Type the length (inside length, like the number on the wall), then tap the way the wall goes." />
                    <!-- the four ways a wall can go: the corner is placed there -->
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" HorizontalAlignment="Center" Width="270">
                        <Button Grid.Row="0" Grid.Column="1" Classes="tool" Content="Up" HorizontalAlignment="Stretch" Tag="u" Click="OnLengthDirection" />
                        <Button Grid.Row="1" Grid.Column="0" Classes="tool" Content="Left" HorizontalAlignment="Stretch" Tag="l" Click="OnLengthDirection" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="tool" Content="Right" HorizontalAlignment="Stretch" Tag="r" Click="OnLengthDirection" />
                        <Button Grid.Row="2" Grid.Column="1" Classes="tool" Content="Down" HorizontalAlignment="Stretch" Tag="d" Click="OnLengthDirection" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Cancel" Click="OnLengthCancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- quick help (the ? key in the top bar, MainView.Help.cs): the gestures and tools on white paper -->
        <Border x:Name="HelpLayer" IsVisible="False" Background="{DynamicResource ScrimBrush}">
            <Border Classes="dialog" Padding="20,16" Margin="60,36">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="HelpTitle" Text="Help" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundTextBrush}" />
                        <Button Grid.Column="1" Classes="tool primary" Content="Close" Click="OnHelpClose" />
                    </Grid>
                    <Border Grid.Row="1" Background="White" CornerRadius="12" ClipToBounds="True" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <ScrollViewer x:Name="HelpScroll">
                            <ContentControl x:Name="HelpPage" Padding="28,22,28,28" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- About (tap the logo): version, test terms, privacy, licences (MainView.About.cs) -->
        <Border x:Name="AboutLayer" IsVisible="False" Background="{DynamicResource ScrimBrush}">
            <Border Classes="dialog" Padding="20,16" Margin="60,40">
                <Grid ColumnDefinitions="220,*" ColumnSpacing="20">
                    <StackPanel Grid.Column="0" Spacing="10">
                        <Border Background="#FFF1F5FB" CornerRadius="10" Padding="12,8">
                            <Image Source="avares://Icono.Mobile/Assets/icono.png" Height="60" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>
                        <TextBlock Text="icono for tablets" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundTextBrush}" />
                        <TextBlock x:Name="AboutVersion" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="© 2026 Jonas Shojaei" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="Test version: results (dimensions, areas, plans) are aids - check them before you build or buy anything."
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                        <!-- the look of the app (MainView.About.cs): Dark / Light and Soft / Pro / Glass -->
                        <StackPanel x:Name="AboutLookHost" Spacing="5" Margin="0,4,0,4" />
                        <Button Classes="tool" x:Name="AboutTermsButton" Content="Test terms" HorizontalAlignment="Stretch" Click="OnAboutTerms" />
                        <Button Classes="tool" x:Name="AboutPrivacyButton" Content="Privacy" HorizontalAlignment="Stretch" Click="OnAboutPrivacy" />
                        <Button Classes="tool" x:Name="AboutNoticesButton" Content="Licences" HorizontalAlignment="Stretch" Click="OnAboutNotices" />
                        <UniformGrid Columns="2">
                            <Button Classes="tool" Content="Website" HorizontalAlignment="Stretch" Click="OnAboutWebsite" ToolTip.Tip="www.bitbins.de" />
                            <Button Classes="tool" Content="Contact" HorizontalAlignment="Stretch" Click="OnAboutContact" ToolTip.Tip="info@bitbins.de" />
                        </UniformGrid>
                        <Button Classes="tool primary" Content="Close" HorizontalAlignment="Stretch" Click="OnAboutClose" />
                    </StackPanel>
                    <!-- the document: white paper, dark readable text, a colour for every section (AboutDocument.cs) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" ClipToBounds="True" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <ScrollViewer x:Name="AboutScroll">
                            <ContentControl x:Name="AboutPage" Padding="28,22,28,28" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- typing a text (MainView.Text.cs); at the top, so the on-screen keyboard does not cover it -->
        <Border x:Name="TextLayer" IsVisible="False" Background="{DynamicResource ScrimLightBrush}">
            <Border Classes="dialog" Padding="18,14" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="TextTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundTextBrush}" />
                    <TextBox Classes="field" x:Name="TextEntry" FontSize="15" MinHeight="40" TextWrapping="Wrap" />
                    <TextBlock x:Name="TextNote" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Cancel" Click="OnTextCancel" />
                        <Button Classes="tool primary" Content="OK" Click="OnTextOk" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- question in front of everything (unsaved changes) -->
        <Border x:Name="QuestionLayer" IsVisible="False" Background="{DynamicResource ScrimBrush}">
            <Border Classes="dialog" Padding="22,18" MaxWidth="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="QuestionTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundTextBrush}" />
                    <TextBlock x:Name="QuestionText" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Cancel" Click="OnQuestionCancel" />
                        <Button Classes="tool" Content="Don't save" Click="OnQuestionDiscard" />
                        <Button Classes="tool primary" Content="Save" Click="OnQuestionSave" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
