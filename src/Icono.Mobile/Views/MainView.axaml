<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Icono.Mobile.Views"
             x:Class="Icono.Mobile.Views.MainView"
             Background="{StaticResource CanvasSurroundBrush}">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- top bar -->
            <Border Grid.Row="0" Background="{StaticResource ToolbarBackgroundBrush}" Padding="10,6"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- the logo on a light plate, like the app icon: its fine blue lines get lost on the dark bar -->
                    <Border Grid.Column="0" x:Name="LogoPlate" Background="#FFF1F5FB" CornerRadius="8" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center"
                            Cursor="Hand" ToolTip.Tip="About icono">
                        <Image Source="avares://Icono.Mobile/Assets/icono.png" Height="26" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>

                    <TextBlock Grid.Column="1" x:Name="TitleText" VerticalAlignment="Center" FontSize="14"
                               Foreground="{StaticResource ForegroundTextBrush}" TextTrimming="CharacterEllipsis" Text="Untitled" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Classes="tool" Content="New" Click="OnNew" />
                        <Button Classes="tool" Content="Open" Click="OnOpen" />
                        <Button Classes="tool" Content="Save" Click="OnSave" />
                        <Button Classes="tool" Content="Save as" Click="OnSaveAs" />
                        <Button Classes="tool" Content="Export" Click="OnExport" />
                        <Border Classes="separator" />
                        <Button Classes="tool" x:Name="UndoButton" Content="Undo" Click="OnUndo" />
                        <Button Classes="tool" x:Name="RedoButton" Content="Redo" Click="OnRedo" />
                        <Border Classes="separator" />
                        <Button Classes="tool" x:Name="DuplicateButton" Content="Duplicate" Click="OnDuplicate" />
                        <Button Classes="tool" x:Name="DeleteButton" Content="Delete" Click="OnDelete" />
                        <Border Classes="separator" />
                        <Button Classes="tool" Content="Fit" Click="OnFit" />
                        <Button Classes="tool on" x:Name="PropertiesButton" Content="Properties" Click="OnToggleProperties" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                <!-- the tools (filled in MainView.Tools.cs) -->
                <Border Grid.Column="0" Background="{StaticResource ToolbarBackgroundBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ToolPanel" Margin="3,6" Spacing="2" />
                    </ScrollViewer>
                </Border>

                <!-- the drawing -->
                <views:DocumentCanvas Grid.Column="1" x:Name="Canvas" ClipToBounds="True" />

                <!-- the object library (Objects in the tool bar) lies over the left of the drawing -->
                <Border Grid.Column="1" x:Name="LibraryPane" IsVisible="False" Width="300" HorizontalAlignment="Left"
                        Background="{StaticResource ToolbarBackgroundBrush}" BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,1,0">
                    <views:ObjectLibrary x:Name="Library" />
                </Border>

                <!-- while a wall, polyline or dimension is drawn -->
                <Border Grid.Column="1" x:Name="PathBar" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"
                        Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="12" Padding="10,6"
                        BorderBrush="{StaticResource RaisedPressedBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="PathBarText" VerticalAlignment="Center" FontSize="13" Margin="4,0,10,0"
                                   Foreground="{StaticResource ForegroundTextBrush}" />
                        <Button Classes="tool" x:Name="PathLengthButton" Content="Length..." Click="OnPathLength" IsVisible="False" />
                        <Button Classes="tool" x:Name="PathUndoButton" Content="Undo point" Click="OnPathUndoPoint" />
                        <Button Classes="tool" Content="Cancel" Click="OnPathCancel" />
                        <Button Classes="tool primary" x:Name="PathDoneButton" Content="Done" Click="OnPathDone" />
                    </StackPanel>
                </Border>

                <!-- the properties of the selection (Properties in the top bar shows / hides it) -->
                <Border Grid.Column="2" x:Name="PropertiesPane" Width="250" Background="{StaticResource ToolbarBackgroundBrush}"
                        BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1,0,0,0">
                    <views:PropertiesPanel x:Name="Properties" />
                </Border>
            </Grid>

            <!-- status line -->
            <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" Padding="12,4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" x:Name="ZoomText" FontSize="12" Foreground="{StaticResource ForegroundTextBrush}" Text="100 %" />
                </Grid>
            </Border>
        </Grid>

        <!-- icono's own file window (MainView.Files.cs): the drawings of the chosen folder, a name to save under, and always a Cancel -->
        <Border x:Name="FilesLayer" IsVisible="False" Background="#99000000">
            <Border Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="14" Padding="20,16" Width="640" Margin="0,40"
                    HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="{StaticResource RaisedPressedBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <TextBlock x:Name="FilesTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ForegroundTextBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="FilesFolderText" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <Button Grid.Column="1" Classes="tool" x:Name="FilesFolderButton" Content="Choose folder..." Click="OnFilesChooseFolder" />
                        </Grid>
                        <Grid x:Name="FilesNameRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Name" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource ForegroundTextBrush}" />
                            <TextBox Grid.Column="1" x:Name="FilesNameBox" FontSize="14" MinHeight="36" />
                            <TextBlock Grid.Column="2" x:Name="FilesExtensionText" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                        <TextBlock x:Name="FilesNote" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Classes="tool" Content="Other location..." Click="OnFilesOtherLocation" />
                        <Button Classes="tool" Content="Cancel" Click="OnFilesCancel" />
                        <Button Classes="tool primary" x:Name="FilesActionButton" Content="Save" Click="OnFilesAction" />
                    </StackPanel>

                    <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Margin="0,8,0,0" MaxHeight="420">
                        <ScrollViewer>
                            <StackPanel x:Name="FilesList" Margin="6" Spacing="2" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

        <!-- Export as PDF or PNG, saved or shared (MainView.Export.cs) -->
        <Border x:Name="ExportLayer" IsVisible="False" Background="#99000000">
            <Border Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="14" Padding="22,18" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource RaisedPressedBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Export" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ForegroundTextBrush}" />

                    <TextBlock Text="FORMAT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <UniformGrid Columns="2">
                        <Button Classes="tool" x:Name="ExportPdfButton" Content="PDF (real size, vectors)" HorizontalAlignment="Stretch" Click="OnExportPdf" />
                        <Button Classes="tool" x:Name="ExportPngButton" Content="PNG (image)" HorizontalAlignment="Stretch" Click="OnExportPng" />
                    </UniformGrid>

                    <TextBlock Text="PAGES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <UniformGrid Columns="2">
                        <Button Classes="tool" x:Name="ExportCurrentButton" HorizontalAlignment="Stretch" Click="OnExportCurrentPage" />
                        <Button Classes="tool" x:Name="ExportAllButton" HorizontalAlignment="Stretch" Click="OnExportAllPages" />
                    </UniformGrid>

                    <StackPanel x:Name="ExportResolutionPanel" Spacing="10">
                        <TextBlock Text="RESOLUTION" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <UniformGrid Columns="3">
                            <Button Classes="tool" x:Name="ExportDpi96" Content="96 dpi" HorizontalAlignment="Stretch" Click="OnExportDpi" Tag="96" />
                            <Button Classes="tool" x:Name="ExportDpi150" Content="150 dpi" HorizontalAlignment="Stretch" Click="OnExportDpi" Tag="150" />
                            <Button Classes="tool" x:Name="ExportDpi300" Content="300 dpi" HorizontalAlignment="Stretch" Click="OnExportDpi" Tag="300" />
                        </UniformGrid>
                    </StackPanel>

                    <CheckBox x:Name="ExportBackground" Content="With the page background" IsChecked="True" FontSize="13"
                              Foreground="{StaticResource ForegroundTextBrush}" />
                    <TextBlock x:Name="ExportInfo" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="tool" Content="Cancel" Click="OnExportCancel" />
                        <Button Classes="tool" x:Name="ExportSaveButton" Content="Save..." Click="OnExportSave" />
                        <Button Classes="tool primary" x:Name="ExportShareButton" Content="Share..." Click="OnExportShare" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- the length of the next wall and the way it goes (MainView.TypedWall.cs); at the top, so the on-screen keyboard does not cover it -->
        <Border x:Name="LengthLayer" IsVisible="False" Background="#66000000">
            <Border Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="14" Padding="18,14" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                    BorderBrush="{StaticResource RaisedPressedBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Next wall" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ForegroundTextBrush}" />
                    <TextBox x:Name="LengthEntry" FontSize="15" MinHeight="40" PlaceholderText="Length, e.g. 250 or 2.5 m" />
                    <TextBlock x:Name="LengthNote" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                               Text="Type the length (inside length, like the number on the wall), then tap the way the wall goes." />
                    <!-- the four ways a wall can go: the corner is placed there -->
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" HorizontalAlignment="Center" Width="270">
                        <Button Grid.Row="0" Grid.Column="1" Classes="tool" Content="Up" HorizontalAlignment="Stretch" Tag="u" Click="OnLengthDirection" />
                        <Button Grid.Row="1" Grid.Column="0" Classes="tool" Content="Left" HorizontalAlignment="Stretch" Tag="l" Click="OnLengthDirection" />
                        <Button Grid.Row="1" Grid.Column="2" Classes="tool" Content="Right" HorizontalAlignment="Stretch" Tag="r" Click="OnLengthDirection" />
                        <Button Grid.Row="2" Grid.Column="1" Classes="tool" Content="Down" HorizontalAlignment="Stretch" Tag="d" Click="OnLengthDirection" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Cancel" Click="OnLengthCancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- About (tap the logo): version, test terms, privacy, licences (MainView.About.cs) -->
        <Border x:Name="AboutLayer" IsVisible="False" Background="#99000000">
            <Border Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="14" Padding="20,16" Margin="60,40"
                    BorderBrush="{StaticResource RaisedPressedBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="220,*" ColumnSpacing="20">
                    <StackPanel Grid.Column="0" Spacing="10">
                        <Border Background="#FFF1F5FB" CornerRadius="10" Padding="12,8">
                            <Image Source="avares://Icono.Mobile/Assets/icono.png" Height="60" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>
                        <TextBlock Text="icono for tablets" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ForegroundTextBrush}" />
                        <TextBlock x:Name="AboutVersion" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="© 2026 Jonas Shojaei" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Test version: results (dimensions, areas, plans) are aids - check them before you build or buy anything."
                                   FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        <Button Classes="tool" x:Name="AboutTermsButton" Content="Test terms" HorizontalAlignment="Stretch" Click="OnAboutTerms" />
                        <Button Classes="tool" x:Name="AboutPrivacyButton" Content="Privacy" HorizontalAlignment="Stretch" Click="OnAboutPrivacy" />
                        <Button Classes="tool" x:Name="AboutNoticesButton" Content="Licences" HorizontalAlignment="Stretch" Click="OnAboutNotices" />
                        <Button Classes="tool primary" Content="Close" HorizontalAlignment="Stretch" Click="OnAboutClose" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="14,10">
                        <ScrollViewer x:Name="AboutScroll">
                            <SelectableTextBlock x:Name="AboutText" FontFamily="monospace" FontSize="11.5" TextWrapping="Wrap"
                                                 Foreground="{StaticResource ForegroundTextBrush}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- typing a text (MainView.Text.cs); at the top, so the on-screen keyboard does not cover it -->
        <Border x:Name="TextLayer" IsVisible="False" Background="#66000000">
            <Border Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="14" Padding="18,14" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"
                    BorderBrush="{StaticResource RaisedPressedBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="TextTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ForegroundTextBrush}" />
                    <TextBox x:Name="TextEntry" FontSize="15" MinHeight="40" TextWrapping="Wrap" />
                    <TextBlock x:Name="TextNote" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Cancel" Click="OnTextCancel" />
                        <Button Classes="tool primary" Content="OK" Click="OnTextOk" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- question in front of everything (unsaved changes) -->
        <Border x:Name="QuestionLayer" IsVisible="False" Background="#99000000">
            <Border Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="14" Padding="22,18" MaxWidth="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource RaisedPressedBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="QuestionTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ForegroundTextBrush}" />
                    <TextBlock x:Name="QuestionText" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="tool" Content="Cancel" Click="OnQuestionCancel" />
                        <Button Classes="tool" Content="Don't save" Click="OnQuestionDiscard" />
                        <Button Classes="tool primary" Content="Save" Click="OnQuestionSave" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
