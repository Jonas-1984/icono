<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tablet user interface of icono (Avalonia). It draws with the same Icono.Core / Icono.Rendering / Icono.IO as the Windows
       program; Icono.Mobile.Android packs it into the Android app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Skia must accept the SkiaSharp 4 that Icono.Rendering uses (checked on the tablet with 12.1.6). Keep all four in sync. -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Icono.Rendering\Icono.Rendering.csproj" />
    <ProjectReference Include="..\Icono.IO\Icono.IO.csproj" />
    <ProjectReference Include="..\Icono.Editor\Icono.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\Icono.App\Assets\icono.png" Link="Assets\icono.png" />
    <AvaloniaResource Include="..\Icono.App\Assets\Samples\icono-logo.svg" Link="Assets\Samples\icono-logo.svg" />
    <!-- Selawik (SIL OFL 1.1): stands in for Segoe UI and other Windows fonts the tablet does not have -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- the licence notices travel with every copy of the app (shown in About: tap the logo) -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.txt" Link="Assets\Notices\THIRD-PARTY-NOTICES.txt" />
    <AvaloniaResource Include="..\..\installer\docs\THIRD-PARTY-NOTICES-DOTNET.txt" Link="Assets\Notices\THIRD-PARTY-NOTICES-DOTNET.txt" />
    <AvaloniaResource Include="Assets\Fonts\Selawik-OFL.txt" Link="Assets\Notices\Selawik-OFL.txt" />
    <!-- the test terms and the privacy notice of the testers' version (same texts as the Windows installer shows) -->
    <AvaloniaResource Include="..\..\installer\docs\Terms-EN.txt" Link="Assets\Docs\Terms-EN.txt" />
    <AvaloniaResource Include="..\..\installer\docs\Testbedingungen-DE.txt" Link="Assets\Docs\Testbedingungen-DE.txt" />
    <AvaloniaResource Include="..\..\installer\docs\Privacy-EN.txt" Link="Assets\Docs\Privacy-EN.txt" />
    <AvaloniaResource Include="..\..\installer\docs\Datenschutz-DE.txt" Link="Assets\Docs\Datenschutz-DE.txt" />
    <!-- the quick help of the tablet app (the ? key in the top bar) -->
    <AvaloniaResource Include="Assets/Help/*.txt" />
  </ItemGroup>

</Project>
