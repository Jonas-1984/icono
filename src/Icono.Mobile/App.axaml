<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Icono.Mobile.App"
             RequestedThemeVariant="Dark">

    <!-- Colours of the standard dark design of the Windows program (Themes/DarkPalette.xaml). -->
    <Application.Resources>
        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF14171E" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF0B0D12" />
        <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#FF06070A" />
        <SolidColorBrush x:Key="BorderLineBrush" Color="#FF030405" />
        <SolidColorBrush x:Key="ForegroundTextBrush" Color="#FFE9F0FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF8994A8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5AB0FF" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#FF1C2029" />
        <SolidColorBrush x:Key="RaisedPressedBrush" Color="#FF262B36" />

        <!-- the accent of check boxes, sliders, focus marks ...: icono blue, not the device's accent colour (red on Xiaomi) -->
        <Color x:Key="SystemAccentColor">#FF5AB0FF</Color>
        <Color x:Key="SystemAccentColorDark1">#FF4A9BE6</Color>
        <Color x:Key="SystemAccentColorDark2">#FF3B86CC</Color>
        <Color x:Key="SystemAccentColorDark3">#FF2C6CB0</Color>
        <Color x:Key="SystemAccentColorLight1">#FF7BC0FF</Color>
        <Color x:Key="SystemAccentColorLight2">#FF9ED2FF</Color>
        <Color x:Key="SystemAccentColorLight3">#FFC2E2FF</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Toolbar buttons: still easy to hit with a finger (38 dp high). -->
        <Style Selector="Button.listRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.listRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#18FFFFFF" />
        </Style>
        <Style Selector="Button.listRow:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#335AB0FF" />
        </Style>
        <!-- the keys of the number pad (NumberPad.cs): frosted glass with a fine rim; OK is blue -->
        <Style Selector="Button.padKey">
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#3CFFFFFF" />
                    <GradientStop Offset="1" Color="#22FFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.padKey.soft">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#26FFFFFF" />
                    <GradientStop Offset="1" Color="#12FFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.padKey.ok">
            <Setter Property="Foreground" Value="#FF06101C" />
            <Setter Property="BorderBrush" Value="#88D6EBFF" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F086C6FF" />
                    <GradientStop Offset="1" Color="#F03F93E8" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.padKey:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#66FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.padKey.ok:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3B86CC" />
            <Setter Property="Foreground" Value="#FF06101C" />
        </Style>
        <Style Selector="Button.padKey:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#99FFFFFF" />
        </Style>
        <Style Selector="Border.dialog">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 18 48 0 #AA000000" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FF1D2330" />
                    <GradientStop Offset="1" Color="#FF131720" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundTextBrush}" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FF272D3A" />
                    <GradientStop Offset="1" Color="#FF1D222C" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#665AB0FF" />
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RaisedPressedBrush}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ToolbarBackgroundBrush}" />
            <Setter Property="Foreground" Value="#FF4A5263" />
        </Style>
        <!-- a toolbar button that switches something on (Properties) -->
        <Style Selector="Button.tool.on">
            <Setter Property="Background" Value="#335AB0FF" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="#FF06070A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#557BC0FF" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FF86C6FF" />
                    <GradientStop Offset="1" Color="#FF4F9FEA" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#FFD6EBFF" />
            <Setter Property="Foreground" Value="#FF06070A" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF3B86CC" />
            <Setter Property="Foreground" Value="#FF06070A" />
        </Style>

        <!-- the tool bar on the left: soft round keys with icon and name; the active tool glows -->
        <Style Selector="Button.palette">
            <Setter Property="Width" Value="44" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="1,3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.palette:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="Button.palette:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <Style Selector="Button.palette.active /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#4D5AB0FF" />
                    <GradientStop Offset="1" Color="#26398FE0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#995AB0FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 0 12 0 #405AB0FF" />
        </Style>
        <Style Selector="Button.palette.active">
            <Setter Property="Foreground" Value="#FFD6EBFF" />
        </Style>
        <Style Selector="Border.paletteLine">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Button.pillKey">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pillKey:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2AFFFFFF" />
        </Style>
        <Style Selector="Button.pillKey:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3AFFFFFF" />
        </Style>
        <Style Selector="Button.pillKey.on /template/ ContentPresenter">
            <Setter Property="Background" Value="#335AB0FF" />
        </Style>
        <Style Selector="Button.pillKey.on">
            <Setter Property="Foreground" Value="#FFD6EBFF" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- the properties panel: segmented tabs, section cards, inset fields, soft keys -->
        <Style Selector="Border.segPlate">
            <Setter Property="Background" Value="#FF0D1016" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.seg">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="Button.seg.on /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#4D5AB0FF" />
                    <GradientStop Offset="1" Color="#26398FE0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#885AB0FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.seg.on">
            <Setter Property="Foreground" Value="#FFD6EBFF" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="Button.soft">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundTextBrush}" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FF272D3A" />
                    <GradientStop Offset="1" Color="#FF1D222C" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.soft:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#665AB0FF" />
        </Style>
        <Style Selector="Button.soft:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF303847" />
        </Style>
        <Style Selector="Button.soft:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#FF0D1016" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FF0D1016" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#FF5AB0FF" />
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#FF0D1016" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
        </Style>

        <!-- small icon buttons (layer list): no grey box when they cannot be used, they only fade -->
        <Style Selector="Button.icon:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- thin line between groups of toolbar buttons -->
        <Style Selector="Border.separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="{StaticResource RaisedPressedBrush}" />
        </Style>

        <!-- the number pad (NumberPad.cs) brings its own frosted glass: the flyout around it is see-through -->
        <Style Selector="FlyoutPresenter.numpad">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>

        <!-- the thin top bar: groups of flat keys with an icon (and a name) -->
        <Style Selector="Border.barGroup">
            <Setter Property="Background" Value="#FF1E2430" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.bar">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFD3DCEB" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.bar.icon">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
        </Style>
        <Style Selector="Button.bar:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Button.bar:disabled">
            <Setter Property="Foreground" Value="#FF485063" />
        </Style>
        <Style Selector="Button.bar:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.bar.on /template/ ContentPresenter">
            <Setter Property="Background" Value="#335AB0FF" />
        </Style>
        <Style Selector="Button.bar.on">
            <Setter Property="Foreground" Value="#FF8CCBFF" />
        </Style>
        <Style Selector="Path.barIcon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.1" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Application.Styles>
</Application>
