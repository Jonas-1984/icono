<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Icono.Mobile.App"
             RequestedThemeVariant="Dark">

    <!-- Colours of the standard dark design of the Windows program (Themes/DarkPalette.xaml). -->
    <Application.Resources>
        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF14171E" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF0B0D12" />
        <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#FF06070A" />
        <SolidColorBrush x:Key="BorderLineBrush" Color="#FF030405" />
        <SolidColorBrush x:Key="ForegroundTextBrush" Color="#FFE9F0FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF8994A8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5AB0FF" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#FF1C2029" />
        <SolidColorBrush x:Key="RaisedPressedBrush" Color="#FF262B36" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Toolbar buttons: big enough for a finger (48 dp high). -->
        <Style Selector="Button.tool">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundTextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource RaisedPressedBrush}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ToolbarBackgroundBrush}" />
            <Setter Property="Foreground" Value="#FF4A5263" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF06070A" />
        </Style>

        <!-- thin line between groups of toolbar buttons -->
        <Style Selector="Border.separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="Background" Value="{StaticResource RaisedPressedBrush}" />
        </Style>
    </Application.Styles>
</Application>
