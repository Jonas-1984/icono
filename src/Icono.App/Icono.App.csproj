<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Icono.Rendering\Icono.Rendering.csproj" />
    <ProjectReference Include="..\Icono.Core\Icono.Core.csproj" />
    <ProjectReference Include="..\Icono.IO\Icono.IO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icono.ico" />
    <Resource Include="Assets\icono.png" />
    <Resource Include="Assets\icono-dark.png" />
    <Resource Include="Assets\Icons\*.ico" />
    <Resource Include="Assets\Samples\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\docs\Handbuch-DE.html" Link="Handbuch-DE.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\docs\Manual-EN.html" Link="Manual-EN.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\docs\Testbedingungen-DE.html" Link="Testbedingungen.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\docs\Terms-EN.html" Link="Terms.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\docs\Datenschutz-DE.html" Link="Datenschutz.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\docs\Privacy-EN.html" Link="Privacy.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\icono-file.ico" Link="icono-file.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>icono</AssemblyName>
    <ApplicationIcon>Assets\icono.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
