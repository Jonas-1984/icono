<Window x:Class="Icono.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Icono.App"
        xmlns:views="clr-namespace:Icono.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="icono" Height="800" Width="1280" MinHeight="600" MinWidth="960"
        Icon="Assets/icono.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="RootChrome"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:TitleBarView Grid.Row="0" x:Name="TitleBar" />

        <Menu x:Name="MainMenu" Grid.Row="1">
            <MenuItem Header="_File">
                <MenuItem Header="New..." InputGestureText="Ctrl+N" Click="NewMenuItem_OnClick" />
                <MenuItem Header="Open..." InputGestureText="Ctrl+O" Click="OpenMenuItem_OnClick" />
                <MenuItem x:Name="RecentMenuItem" Header="Open Recent" SubmenuOpened="RecentMenuItem_OnSubmenuOpened">
                    <MenuItem Header="(none)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="SaveMenuItem_OnClick" />
                <MenuItem Header="Save As..." InputGestureText="Ctrl+Shift+S" Click="SaveAsMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Export..." InputGestureText="Ctrl+E" Click="ExportMenuItem_OnClick" />
                <MenuItem Header="Export PNG (page size)" Click="ExportPngQuickMenuItem_OnClick" />
                <MenuItem Header="Print..." InputGestureText="Ctrl+P" Click="PrintMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="ExitMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="UndoMenuItem_OnClick" />
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="RedoMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="CutMenuItem_OnClick" />
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="CopyMenuItem_OnClick" />
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="PasteMenuItem_OnClick" />
                <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Click="DuplicateMenuItem_OnClick" />
                <MenuItem Header="Delete" InputGestureText="Del" Click="DeleteMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Select All" InputGestureText="Ctrl+A" Click="SelectAllMenuItem_OnClick" />
                <MenuItem Header="Deselect" InputGestureText="Esc" Click="DeselectMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Click="ZoomInMenuItem_OnClick" />
                <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Click="ZoomOutMenuItem_OnClick" />
                <MenuItem Header="Actual Size (100%)" InputGestureText="Ctrl+0" Click="ActualSizeMenuItem_OnClick" />
                <MenuItem Header="Fit Page to Window" InputGestureText="Ctrl+1" Click="FitPageMenuItem_OnClick" />
                <Separator />
                <MenuItem x:Name="GridMenuItem" Header="Show Grid" IsCheckable="True" Click="GridMenuItem_OnClick" />
                <MenuItem x:Name="SnapMenuItem" Header="Snap to Grid" IsCheckable="True" Click="SnapMenuItem_OnClick" />
                <MenuItem x:Name="PointSnapMenuItem" Header="Object Snap (End Points, Middles, Centres ...)" InputGestureText="F3" IsCheckable="True" IsChecked="True" Click="PointSnapMenuItem_OnClick"
                          ToolTip="Every tool snaps to the points of the objects: end points, middles, centres, crossings ... (Alt = off). Choose the kinds in the OBJECT SNAP card." />
                <MenuItem Header="Object Snap Settings..." Click="PointSnapSettingsMenuItem_OnClick" />
                <MenuItem x:Name="ObjectSnapMenuItem" Header="Align Edges While Moving" IsCheckable="True" IsChecked="True" Click="ObjectSnapMenuItem_OnClick"
                          ToolTip="Shapes line up with the faces of walls and the edges of other shapes while moved, placed or resized (Alt = off)" />
                <Separator />
                <MenuItem Header="Theme">
                    <MenuItem x:Name="ViewDarkModeMenuItem" Header="Dark Mode" Click="DarkModeMenuItem_OnClick" />
                    <MenuItem x:Name="ViewLightModeMenuItem" Header="Light Mode" Click="LightModeMenuItem_OnClick" />
                    <Separator />
                    <MenuItem x:Name="ViewSoftStyleMenuItem" Header="Soft Style (neumorphic keys)" Click="SoftStyleMenuItem_OnClick" />
                    <MenuItem x:Name="ViewProStyleMenuItem" Header="Pro Style (flat, content first)" Click="ProStyleMenuItem_OnClick"
                              ToolTip="Dark graphite surfaces, grey panels, clear icons, few decorations and light shadows: the interface steps back for the drawing" />
                    <MenuItem x:Name="ViewGlassStyleMenuItem" Header="Glass Style (translucent, like iOS)" Click="GlassStyleMenuItem_OnClick"
                              ToolTip="Transparent menus, glass keys, light reflections on the edges and depth - in Dark and in Light Mode" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Page">
                <MenuItem Header="Size">
                    <MenuItem Header="A5 (148 x 210 mm)" Tag="A5" Click="PageSizeMenuItem_OnClick" />
                    <MenuItem Header="A4 (210 x 297 mm)" Tag="A4" Click="PageSizeMenuItem_OnClick" />
                    <MenuItem Header="A3 (297 x 420 mm)" Tag="A3" Click="PageSizeMenuItem_OnClick" />
                    <MenuItem Header="Letter (8.5 x 11 in)" Tag="Letter" Click="PageSizeMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="64 x 64 px" Tag="64px" Click="PageSizeMenuItem_OnClick" />
                    <MenuItem Header="128 x 128 px" Tag="128px" Click="PageSizeMenuItem_OnClick" />
                    <MenuItem Header="256 x 256 px" Tag="256px" Click="PageSizeMenuItem_OnClick" />
                    <MenuItem Header="512 x 512 px" Tag="512px" Click="PageSizeMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="Custom Size..." Tag="CANVAS SIZE" Click="FocusCardMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Orientation">
                    <MenuItem x:Name="PortraitMenuItem" Header="Portrait" Tag="Portrait" Click="PageOrientationMenuItem_OnClick" />
                    <MenuItem x:Name="LandscapeMenuItem" Header="Landscape" Tag="Landscape" Click="PageOrientationMenuItem_OnClick" />
                </MenuItem>
                <MenuItem x:Name="ScaleMenuItem" Header="Scale (1:N)" />
                <Separator />
                <MenuItem x:Name="SheetMenuItem" Header="Sheet (frame and title block)" IsCheckable="True" Click="SheetMenuItem_OnClick"
                          ToolTip="Frame round the page with project, address, scale, date and position" />
                <MenuItem Header="Sheet Data..." Tag="SHEET" Click="FocusCardMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Background..." Tag="BACKGROUND" Click="FocusCardMenuItem_OnClick" />
                <MenuItem Header="New Layer" Click="NewLayerMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Insert">
                <MenuItem Header="Shape">
                    <MenuItem Header="Rectangle" Tag="Rectangle" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Rounded Rectangle" Tag="RoundedRectangle" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Ellipse" Tag="Ellipse" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Triangle" Tag="Triangle" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Diamond" Tag="Diamond" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Parallelogram" Tag="Parallelogram" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Trapezoid" Tag="Trapezoid" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Pentagon" Tag="Pentagon" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Hexagon" Tag="Hexagon" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Octagon" Tag="Octagon" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Star" Tag="Star" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Heart" Tag="Heart" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Cross" Tag="Cross" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Half Circle" Tag="HalfCircle" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Ring" Tag="Ring" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Cloud" Tag="Cloud" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Shield" Tag="Shield" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Speech Bubble" Tag="SpeechBubble" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Gear" Tag="Gear" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="3D Box" Tag="Box3D" Click="ToolMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="More shapes, icons and furniture are in the Tools panel" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="Text" InputGestureText="T" Tag="Text" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Design Grid" Tag="DesignGrid" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Door and Window">
                    <MenuItem Header="Door (single)" Tag="DoorSingle" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Double Door" Tag="DoorDouble" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Window" Tag="WindowSingle" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Double Window" Tag="WindowDouble" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Wall Opening" Tag="WallOpening" Click="ToolMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Electrical and Kitchen">
                    <MenuItem Header="Socket" Tag="Socket" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Double Socket" Tag="DoubleSocket" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Electrical Appliance" Tag="ElectricAppliance" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Cooker" Tag="Cooker" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Oven" Tag="Oven" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Microwave" Tag="Microwave" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Water and Waste Water" Tag="WaterAndWastewater" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Cooker Hood" Tag="Hood" Click="ToolMenuItem_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Image..." Click="InsertImageMenuItem_OnClick" />
                <MenuItem Header="SVG Code..." Click="InsertSvgMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Draw">
                <MenuItem Header="Line" Tag="Line" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Arrow" Tag="Arrow" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Double Arrow" Tag="DoubleArrow" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Polyline" Tag="Polyline" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Curve" Tag="Curve" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Line Options..." Tag="LINE" Click="FocusCardMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Wall" InputGestureText="W" Tag="Wall" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Cut Wall" InputGestureText="X" Tag="WallCut" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Add Room">
                    <MenuItem Header="Closed Room" Tag="Closed" Click="RoomMenuItem_OnClick" />
                    <MenuItem Header="Room with One Corner (L-shape)" Tag="OneCorner" Click="RoomMenuItem_OnClick" />
                    <MenuItem Header="Room with One Slanted Wall" Tag="OneSlantedWall" Click="RoomMenuItem_OnClick" />
                    <MenuItem Header="Room with Two Slanted Walls" Tag="TwoSlantedWalls" Click="RoomMenuItem_OnClick" />
                    <MenuItem Header="Room with a Column in the Corner" Tag="CornerColumn" Click="RoomMenuItem_OnClick" />
                    <MenuItem Header="Room with a Column on a Wall" Tag="WallColumn" Click="RoomMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Close Wall (make a closed room)" Click="CloseWallMenuItem_OnClick"
                          ToolTip="Join the last corner of the selected wall to its first corner" />
                <MenuItem Header="Join Selected Walls into One" Click="JoinWallsMenuItem_OnClick"
                          ToolTip="Select two walls (Shift+click) and make them one wall: the nearest ends are joined, walls in one line become one straight wall" />
                <MenuItem Header="Merge Straight Parts of Wall" Click="MergeWallMenuItem_OnClick"
                          ToolTip="Walls that run on in one line become one wall (the corner between them is removed)" />
                <MenuItem Header="Wall Options..." Tag="WALL" Click="FocusCardMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Dimension">
                    <MenuItem Header="Aligned (along the line)" InputGestureText="D" Tag="DimAligned" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Horizontal" Tag="DimHorizontal" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Vertical" Tag="DimVertical" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Angle" Tag="DimAngular" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Radius" Tag="DimRadius" Click="ToolMenuItem_OnClick" />
                    <MenuItem Header="Diameter" Tag="DimDiameter" Click="ToolMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Add Dimensions to Selection">
                    <MenuItem Header="Automatic (suits the shape)" Tag="Auto" Click="AddDimensionsMenuItem_OnClick" />
                    <MenuItem Header="Width, Height &amp; Depth" Tag="Size" Click="AddDimensionsMenuItem_OnClick" />
                    <MenuItem Header="Diameter &amp; Radius" Tag="Round" Click="AddDimensionsMenuItem_OnClick" />
                    <MenuItem Header="Corner Angles" Tag="Corners" Click="AddDimensionsMenuItem_OnClick" />
                    <MenuItem Header="Segment / Curve Lengths" Tag="Segments" Click="AddDimensionsMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Dimension Style..." Tag="DIMENSION" Click="FocusCardMenuItem_OnClick" />
                <MenuItem Header="Door and Window Dimensions">
                    <MenuItem Header="Show on Selected" Tag="ShowSelected" Click="SymbolDimensionMenuItem_OnClick" />
                    <MenuItem Header="Hide on Selected" Tag="HideSelected" Click="SymbolDimensionMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="Show All" Tag="ShowAll" Click="SymbolDimensionMenuItem_OnClick" />
                    <MenuItem Header="Hide All" Tag="HideAll" Click="SymbolDimensionMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Wall Dimensions">
                    <MenuItem Header="Inside the Plan (in the room)" Tag="Inside" Click="WallDimensionPlacementMenuItem_OnClick" />
                    <MenuItem Header="Outside the Plan" Tag="Outside" Click="WallDimensionPlacementMenuItem_OnClick" />
                    <MenuItem Header="Automatic" Tag="Automatic" Click="WallDimensionPlacementMenuItem_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Distance between Objects" InputGestureText="B" Tag="MeasureGap" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Ruler (nothing is added)" InputGestureText="M" Tag="Measure" Click="ToolMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Arrange">
                <MenuItem Header="Bring to Front" Click="BringToFrontButton_OnClick" />
                <MenuItem Header="Send to Back" Click="SendToBackButton_OnClick" />
                <Separator />
                <MenuItem Header="Group" InputGestureText="Ctrl+G" Click="GroupButton_OnClick" />
                <MenuItem Header="Ungroup" InputGestureText="Ctrl+Shift+G" Click="UngroupButton_OnClick" />
                <MenuItem Header="Lock" Click="LockButton_OnClick" />
                <MenuItem Header="Unlock" Click="UnlockButton_OnClick" />
                <Separator />
                <MenuItem Header="Align">
                    <MenuItem Header="Left" Tag="Align:Left" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="Centre Horizontally" Tag="Align:CenterHorizontally" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="Right" Tag="Align:Right" Click="ArrangeMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="Top" Tag="Align:Top" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="Centre Vertically" Tag="Align:CenterVertically" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="Bottom" Tag="Align:Bottom" Click="ArrangeMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="One shape aligns to the page, several to each other" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="Distribute">
                    <MenuItem Header="Horizontally (equal gaps)" Tag="Distribute:H" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="Vertically (equal gaps)" Tag="Distribute:V" Click="ArrangeMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Flip">
                    <MenuItem Header="Horizontal" Tag="Flip:H" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="Vertical" Tag="Flip:V" Click="ArrangeMenuItem_OnClick" />
                </MenuItem>
                <MenuItem Header="Rotate">
                    <MenuItem Header="90° Clockwise" Tag="Rotate:90" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="90° Counter-clockwise" Tag="Rotate:-90" Click="ArrangeMenuItem_OnClick" />
                    <MenuItem Header="180°" Tag="Rotate:180" Click="ArrangeMenuItem_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Merge to One Shape" Click="MergeButton_OnClick" />
                <MenuItem Header="Explode" InputGestureText="Ctrl+Shift+X" Click="ExplodeButton_OnClick" ToolTip="Breaks a combined object (for example a sink from the catalogue) into its single outlines" />
                <MenuItem Header="Union" Click="UnionButton_OnClick" />
                <MenuItem Header="Trim" Click="TrimButton_OnClick" />
                <MenuItem Header="Reflect" Click="ReflectButton_OnClick" />
                <MenuItem Header="Offset..." Click="OffsetButton_OnClick" />
            </MenuItem>
            <MenuItem Header="De_sign">
                <MenuItem Header="Design Style">
                    <MenuItem Header="None (standard)" Tag="None" Click="DesignStyleMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="Glassmorphism" Tag="Glassmorphism" Click="DesignStyleMenuItem_OnClick" />
                    <MenuItem Header="Neumorphism" Tag="Neumorphism" Click="DesignStyleMenuItem_OnClick" />
                    <MenuItem Header="Fluent Design" Tag="FluentDesign" Click="DesignStyleMenuItem_OnClick" />
                    <MenuItem Header="Aurora Gradients" Tag="AuroraGradients" Click="DesignStyleMenuItem_OnClick" />
                    <MenuItem Header="Bento UI" Tag="BentoUI" Click="DesignStyleMenuItem_OnClick" />
                    <MenuItem Header="Cyberpunk / Futuristic UI" Tag="Cyberpunk" Click="DesignStyleMenuItem_OnClick" />
                    <MenuItem Header="3D Claymorphism" Tag="Claymorphism3D" Click="DesignStyleMenuItem_OnClick" />
                    <MenuItem Header="Dark UI + Neon Accents" Tag="DarkNeon" Click="DesignStyleMenuItem_OnClick" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Colors..." Tag="FILL &amp; COLOR" Click="FocusCardMenuItem_OnClick" />
                <MenuItem Header="Border..." Tag="BORDER" Click="FocusCardMenuItem_OnClick" />
                <MenuItem Header="Effects..." Tag="OPACITY, BLUR &amp; SHADOW" Click="FocusCardMenuItem_OnClick" />
                <MenuItem Header="Text Formats..." Tag="TEXT FORMATTING" Click="FocusCardMenuItem_OnClick" />
                <MenuItem Header="Size &amp; Position..." Tag="SIZE &amp; POSITION" Click="FocusCardMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Selection" InputGestureText="V" Tag="Select" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Pan / Zoom" InputGestureText="H" Tag="PanZoom" Click="ToolMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Match Properties" InputGestureText="Q" Tag="Match" Click="ToolMenuItem_OnClick"
                          ToolTip="Copy the look of one object onto others" />
                <MenuItem Header="Eyedropper" InputGestureText="I" Tag="Eyedropper" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Region Color (Bucket)" InputGestureText="G" Tag="RegionColor" Click="ToolMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="Add Point" Tag="AddPoint" Click="ToolMenuItem_OnClick" />
                <MenuItem Header="Delete Point" Tag="DeletePoint" Click="ToolMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Keyboard Shortcuts" Click="ShortcutsMenuItem_OnClick" />
                <MenuItem Header="Documentation" Click="DocumentationMenuItem_OnClick" />
                <MenuItem Header="Check for Updates" Click="UpdatesMenuItem_OnClick" />
                <MenuItem Header="Website (www.bitbins.de)" Click="WebsiteMenuItem_OnClick" />
                <MenuItem Header="Contact (info@bitbins.de)" Click="ContactMenuItem_OnClick" />
                <Separator />
                <MenuItem Header="About icono" Click="AboutMenuItem_OnClick" />
            </MenuItem>
        </Menu>

        <!-- Shadow backdrops (empty borders carrying the drop shadows, see PanelStyles.xaml) -->
        <Border Grid.Row="2" Margin="10,4,10,8" CornerRadius="0" Style="{StaticResource NeuShadowLightStyle}" />
        <Border Grid.Row="2" Margin="10,4,10,8" CornerRadius="0" Style="{StaticResource NeuShadowDarkStyle}" />
        <Border Grid.Row="2" Style="{StaticResource ToolBarBorderStyle}">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Content="New" Margin="3,2" Click="NewMenuItem_OnClick" ToolTip="New document (Ctrl+N)" />
                    <Button Content="Open" Margin="3,2" Click="OpenMenuItem_OnClick" ToolTip="Open document (Ctrl+O)" />
                    <Button Content="Save" Margin="3,2" Click="SaveMenuItem_OnClick" ToolTip="Save document (Ctrl+S)" />
                    <Button Content="Export" Margin="3,2" Click="ExportMenuItem_OnClick" ToolTip="Export as PNG or icon (Ctrl+E)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="UndoMenuItem_OnClick" ToolTip="Undo (Ctrl+Z)">
                        <Path Data="{StaticResource UndoToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="RedoMenuItem_OnClick" ToolTip="Redo (Ctrl+Y)">
                        <Path Data="{StaticResource RedoToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="CutButton_OnClick" ToolTip="Cut (Ctrl+X)">
                        <Path Data="{StaticResource CutToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="CopyButton_OnClick" ToolTip="Copy (Ctrl+C)">
                        <Path Data="{StaticResource CopyToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="PasteButton_OnClick" ToolTip="Paste (Ctrl+V)">
                        <Path Data="{StaticResource PasteToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="DeleteButton_OnClick" ToolTip="Delete (Del)">
                        <Path Data="{StaticResource DeleteToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="MergeButton_OnClick" ToolTip="Merge to One Shape">
                        <Path Data="{StaticResource MergeToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="ExplodeButton_OnClick" ToolTip="Explode: break a combined object into its single outlines (Ctrl+Shift+X)">
                        <Path Data="{StaticResource ExplodeToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="GroupButton_OnClick" ToolTip="Group">
                        <Path Data="{StaticResource GroupToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="UngroupButton_OnClick" ToolTip="Ungroup">
                        <Path Data="{StaticResource UngroupToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="LockButton_OnClick" ToolTip="Lock">
                        <Path Data="{StaticResource LockToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="UnlockButton_OnClick" ToolTip="Unlock">
                        <Path Data="{StaticResource UnlockToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="BringToFrontButton_OnClick" ToolTip="Bring to Front">
                        <Path Data="{StaticResource BringToFrontToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="SendToBackButton_OnClick" ToolTip="Send to Back">
                        <Path Data="{StaticResource SendToBackToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="AlignDropDownButton" Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="DropDownButton_OnClick"
                            ToolTip="Align and distribute (one shape aligns to the page, several to each other)">
                        <Path Data="{StaticResource AlignLeftToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Align Left" Tag="Align:Left" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Align Centre Horizontally" Tag="Align:CenterHorizontally" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Align Right" Tag="Align:Right" Click="ArrangeMenuItem_OnClick" />
                                <Separator />
                                <MenuItem Header="Align Top" Tag="Align:Top" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Align Centre Vertically" Tag="Align:CenterVertically" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Align Bottom" Tag="Align:Bottom" Click="ArrangeMenuItem_OnClick" />
                                <Separator />
                                <MenuItem Header="Distribute Horizontally" Tag="Distribute:H" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Distribute Vertically" Tag="Distribute:V" Click="ArrangeMenuItem_OnClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="TransformDropDownButton" Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="DropDownButton_OnClick"
                            ToolTip="Flip and rotate the selection">
                        <Path Data="{StaticResource FlipHorizontalToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Flip Horizontal" Tag="Flip:H" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Flip Vertical" Tag="Flip:V" Click="ArrangeMenuItem_OnClick" />
                                <Separator />
                                <MenuItem Header="Rotate 90° Clockwise" Tag="Rotate:90" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Rotate 90° Counter-clockwise" Tag="Rotate:-90" Click="ArrangeMenuItem_OnClick" />
                                <MenuItem Header="Rotate 180°" Tag="Rotate:180" Click="ArrangeMenuItem_OnClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <RadioButton x:Name="BorderToolbarRadio" GroupName="ToolSelection" Style="{StaticResource ToolbarSquareImageRadioButtonStyle}"
                                 Checked="BorderToolRadioButton_OnChecked" Tag="{StaticResource BorderIconImage}" ToolTip="Border options: opens the BORDER card (thickness, colour, style, corners)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="UnionButton_OnClick"
                            ToolTip="Union: merge 2+ selected shapes into one (overlap included)">
                        <Path Data="{StaticResource UnionToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="TrimButton_OnClick"
                            ToolTip="Trim: select exactly 2 shapes — click the CUTTER first, then Ctrl+click the TARGET; the cutter is removed, the target keeps only what wasn't covered">
                        <Path Data="{StaticResource TrimToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="ReflectButton_OnClick"
                            ToolTip="Reflect: adds a fading mirrored copy below the shape, like a water reflection">
                        <Path Data="{StaticResource ReflectToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="OffsetButton_OnClick"
                            ToolTip="Offset: adds a copy of the shape's border, grown or shrunk by a distance you choose">
                        <Path Data="{StaticResource OffsetToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <ToggleButton x:Name="GridToggleButton" Margin="3,2" Padding="6,4" Checked="GridToggleButton_OnToggled" Unchecked="GridToggleButton_OnToggled" ToolTip="Show Grid">
                        <Path Data="{StaticResource GridToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" />
                    </ToggleButton>
                    <ToggleButton x:Name="SnapToggleButton" Margin="3,2" Padding="6,4" Checked="SnapToggleButton_OnToggled" Unchecked="SnapToggleButton_OnToggled" ToolTip="Snap to Grid">
                        <Path Data="{StaticResource SnapToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" />
                    </ToggleButton>
                    <TextBox x:Name="GridSizeTextBox" Width="44" Margin="3,2,0,2" VerticalContentAlignment="Center"
                             TextAlignment="Center" ToolTip="Main grid square size"
                             LostFocus="GridSizeTextBox_OnLostFocus" KeyDown="GridSizeTextBox_OnKeyDown" />
                    <TextBlock x:Name="GridUnitText" Text="px" Margin="4,0,3,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="8,4,8,8" Style="{StaticResource NeuShadowLightStyle}" />
            <Border Grid.Column="0" Margin="8,4,8,8" Style="{StaticResource NeuShadowDarkStyle}" />
            <views:ToolPanelView Grid.Column="0" x:Name="ToolPanel" />
            <GridSplitter Grid.Column="1" Style="{StaticResource GlossyBlueSplitterStyle}" />
            <views:CanvasHostView Grid.Column="2" x:Name="CanvasHost"
                                   Zoom="{Binding ElementName=StatusBar, Path=ZoomValue}" />
            <GridSplitter Grid.Column="3" Style="{StaticResource GlossyBlueSplitterStyle}" />
            <Border Grid.Column="4" Margin="8,4,8,8" Style="{StaticResource NeuShadowLightStyle}" />
            <Border Grid.Column="4" Margin="8,4,8,8" Style="{StaticResource NeuShadowDarkStyle}" />
            <views:PropertiesPanelView Grid.Column="4" x:Name="PropertiesPanel" />
        </Grid>

        <views:StatusBarView Grid.Row="4" x:Name="StatusBar" />
    </Grid>
    </Border>
</Window>
