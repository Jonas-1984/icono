<Window x:Class="Icono.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Icono.App"
        xmlns:views="clr-namespace:Icono.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="icono" Height="800" Width="1280" MinHeight="600" MinWidth="960"
        Icon="Assets/icono.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="RootChrome"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{StaticResource WindowEdgeBrush}"
            Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:TitleBarView Grid.Row="0" x:Name="TitleBar" />

        <Menu Grid.Row="1">
            <MenuItem Header="File">
                <MenuItem Header="New Icon" IsEnabled="False" />
                <MenuItem Header="Open..." IsEnabled="False" />
                <MenuItem Header="Save" IsEnabled="False" />
                <MenuItem Header="Save As..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="Export" IsEnabled="False">
                    <MenuItem Header="64 x 64" IsEnabled="False" />
                    <MenuItem Header="128 x 128" IsEnabled="False" />
                    <MenuItem Header="256 x 256" IsEnabled="False" />
                    <MenuItem Header="512 x 512" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="Export All Sizes..." IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="Recent Files" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Exit" Click="ExitMenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="Home">
                <MenuItem Header="Undo" IsEnabled="False" />
                <MenuItem Header="Redo" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Cut" IsEnabled="False" />
                <MenuItem Header="Copy" IsEnabled="False" />
                <MenuItem Header="Paste" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Zoom In" IsEnabled="False" />
                <MenuItem Header="Zoom Out" IsEnabled="False" />
                <MenuItem Header="Reset Zoom" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Selection Tool" IsEnabled="False" />
                <MenuItem Header="Pan / Zoom Tool" IsEnabled="False" />
                <MenuItem Header="Eyedropper" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="Insert">
                <MenuItem Header="Shape" IsEnabled="False">
                    <MenuItem Header="Square" IsEnabled="False" />
                    <MenuItem Header="Rectangle" IsEnabled="False" />
                    <MenuItem Header="Circle" IsEnabled="False" />
                    <MenuItem Header="Triangle" IsEnabled="False" />
                    <MenuItem Header="Polygon" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="Text" IsEnabled="False" />
                <MenuItem Header="Image..." IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="Draw">
                <MenuItem Header="Line Tool" IsEnabled="False" />
                <MenuItem Header="Arrow Tool" IsEnabled="False" />
                <MenuItem Header="Border Tool" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="Design">
                <MenuItem Header="Border Style..." IsEnabled="False" />
                <MenuItem Header="Text Formats..." IsEnabled="False" />
                <MenuItem Header="Colors..." IsEnabled="False" />
                <MenuItem Header="Gradient / Gloss Presets..." IsEnabled="False" />
                <MenuItem Header="Canvas Size..." IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About icono" Click="AboutMenuItem_OnClick" />
                <MenuItem Header="Documentation" IsEnabled="False" />
                <MenuItem Header="Check for Updates" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="2" Style="{StaticResource ToolBarBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Button Content="New" Margin="2,0" IsEnabled="False" />
                <Button Content="Open" Margin="2,0" IsEnabled="False" />
                <Button Content="Save" Margin="2,0" IsEnabled="False" />
                <Separator Width="1" Margin="6,2" />
                <Button Content="Export" Margin="2,0" IsEnabled="False" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <views:ToolPanelView Grid.Column="0" x:Name="ToolPanel" />
            <GridSplitter Grid.Column="1" Style="{StaticResource GlossyBlueSplitterStyle}" />
            <views:CanvasHostView Grid.Column="2" x:Name="CanvasHost"
                                   Zoom="{Binding ElementName=StatusBar, Path=ZoomValue}" />
            <GridSplitter Grid.Column="3" Style="{StaticResource GlossyBlueSplitterStyle}" />
            <views:PropertiesPanelView Grid.Column="4" x:Name="PropertiesPanel" />
        </Grid>

        <views:StatusBarView Grid.Row="4" x:Name="StatusBar" />
    </Grid>
    </Border>
</Window>
