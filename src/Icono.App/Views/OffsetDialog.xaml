<local:ThemedDialogWindow x:Class="Icono.App.Views.OffsetDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Icono.App.Views"
                          Title="Offset">
    <local:DialogCard Title="Offset distance" MinWidth="360">
        <StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Positive values grow the shape outward, negative values shrink it inward. A new copy is added, the original stays untouched." />

            <TextBlock Text="DISTANCE (PX)" Style="{StaticResource PanelLabelTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="DistanceTextBox" Text="4" TextAlignment="Center" FontSize="14" Height="34"
                     KeyDown="DistanceTextBox_OnKeyDown" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" MinWidth="92" Height="32" Margin="0,0,8,0" Click="CancelButton_OnClick" IsCancel="True" />
                <Button Content="Apply" MinWidth="92" Height="32" Click="ApplyButton_OnClick" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </local:DialogCard>
</local:ThemedDialogWindow>
