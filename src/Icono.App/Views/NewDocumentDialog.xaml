<local:ThemedDialogWindow x:Class="Icono.App.Views.NewDocumentDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Icono.App.Views"
                          Title="New document">
    <local:DialogCard Title="New document" Width="400">
        <StackPanel>
            <TextBlock Text="PRESET" Style="{StaticResource PanelLabelTextStyle}" Margin="0,0,0,4" />
            <ComboBox x:Name="PresetComboBox" Height="32" DisplayMemberPath="Label" SelectionChanged="PresetComboBox_OnSelectionChanged" />

            <TextBlock Text="SIZE (PX)" Style="{StaticResource PanelLabelTextStyle}" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WidthTextBox" Height="32" TextAlignment="Center" ToolTip="Width in px" />
                <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="12,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="HeightTextBox" Grid.Column="2" Height="32" TextAlignment="Center" ToolTip="Height in px" />
            </Grid>
            <TextBlock x:Name="SizeHintText" FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}" />

            <TextBlock Text="BACKGROUND" Style="{StaticResource PanelLabelTextStyle}" Margin="0,14,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="WhiteRadio" GroupName="NewBackground" Content="White" IsChecked="True" Margin="0,0,18,0"
                             Foreground="{DynamicResource ForegroundTextBrush}" />
                <RadioButton x:Name="TransparentRadio" GroupName="NewBackground" Content="Transparent"
                             Foreground="{DynamicResource ForegroundTextBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" MinWidth="92" Height="32" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_OnClick" />
                <Button Content="Create" MinWidth="92" Height="32" IsDefault="True" Click="CreateButton_OnClick" />
            </StackPanel>
        </StackPanel>
    </local:DialogCard>
</local:ThemedDialogWindow>
