<UserControl x:Class="Icono.App.Views.IconLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MY ICONS" Style="{StaticResource CardHeaderTextStyle}" />
                <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
            </Grid>
            <StackPanel>
                <Grid Margin="6,0,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveSelectionButton" Grid.Column="0" Content="+ Save Selection"
                            Click="SaveSelectionButton_OnClick" />
                    <Button x:Name="ImportSvgButton" Grid.Column="2" Click="ImportSvgButton_OnClick" ToolTip="Import SVG...">
                        <Path Data="{StaticResource ImagePlusToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="ImportImageButton" Grid.Column="4" Click="ImportImageButton_OnClick" ToolTip="Import Image (.png, .ico, .svg)...">
                        <Path Data="{StaticResource ImageDownToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </Grid>
                <TextBlock x:Name="EmptyHint" Text="No saved icons yet — select one or more shapes and click &quot;+ Save Selection&quot;."
                           FontSize="10" TextWrapping="Wrap" Margin="6,0,6,6"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <ItemsControl x:Name="LibraryItemsControl" Margin="6,0,6,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel x:Name="ItemRoot" Width="60" Margin="2" Cursor="Hand"
                                        MouseLeftButtonDown="LibraryItem_OnMouseLeftButtonDown" Tag="{Binding}">
                                <Grid Width="56" Height="56">
                                    <Border CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}" Width="52" Height="52" />
                                    </Border>
                                    <Button x:Name="DeleteButton" Width="18" Height="18" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                            Visibility="Collapsed" Background="#CC2B2B2B" BorderThickness="0"
                                            Click="DeleteLibraryItem_OnClick" Tag="{Binding}" ToolTip="Remove from library">
                                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="White"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="8" Height="8" Stretch="Uniform" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ItemRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
