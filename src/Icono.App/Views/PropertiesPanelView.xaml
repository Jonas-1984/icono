<UserControl x:Class="Icono.App.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Icono.App.Views"
             xmlns:converters="clr-namespace:Icono.App.Converters">
    <UserControl.Resources>
        <converters:ShapeNameConverter x:Key="ShapeNameConverter" />
    </UserControl.Resources>
    <Border Style="{StaticResource SidePanelBorderStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Canvas" Style="{StaticResource PanelHeaderTextStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BACKGROUND" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                                <RadioButton x:Name="BgTransparentRadio" GroupName="BgMode" Content="Transparent" IsChecked="True"
                                             Checked="BackgroundModeRadio_OnChecked" Tag="Transparent" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="BgSolidRadio" GroupName="BgMode" Content="Color"
                                             Checked="BackgroundModeRadio_OnChecked" Tag="SolidColor" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="BgBlurRadio" GroupName="BgMode" Content="Blur"
                                             Checked="BackgroundModeRadio_OnChecked" Tag="Blur"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <views:ColorPickerView x:Name="BackgroundColorPicker" Margin="6,0,6,6" Visibility="Collapsed" />

                            <StackPanel x:Name="BackgroundBlurSettingsPanel" Visibility="Collapsed">
                                <TextBlock Text="BLUR COLOR" Style="{StaticResource PanelLabelTextStyle}" />
                                <views:ColorPickerView x:Name="BackgroundBlurColorPicker" Margin="6,0,6,6" />

                                <CheckBox x:Name="BackgroundBlurGradientCheckBox" Content="GRADIENT" Margin="6,0,6,2"
                                          Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                          Checked="BackgroundBlurGradientCheckBox_OnCheckedChanged"
                                          Unchecked="BackgroundBlurGradientCheckBox_OnCheckedChanged" />
                                <views:ColorPickerView x:Name="BackgroundBlurGradientColorPicker" Margin="6,0,6,6"
                                                        Visibility="Collapsed" />

                                <TextBlock Text="BLUR" Style="{StaticResource PanelLabelTextStyle}" />
                                <Grid Margin="6,0,6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BackgroundBlurAmountSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                            ValueChanged="BackgroundBlurAmountSlider_OnValueChanged" />
                                    <TextBlock x:Name="BackgroundBlurAmountValueText" Grid.Column="1" Text="60%"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="FADE" Style="{StaticResource PanelLabelTextStyle}" />
                                <Grid Margin="6,0,6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BackgroundFadeAmountSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                            ValueChanged="BackgroundFadeAmountSlider_OnValueChanged" />
                                    <TextBlock x:Name="BackgroundFadeAmountValueText" Grid.Column="1" Text="40%"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="OPACITY" Style="{StaticResource PanelLabelTextStyle}" />
                                <Grid Margin="6,0,6,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BackgroundOpacitySlider" Grid.Column="0" Minimum="0" Maximum="100"
                                            ValueChanged="BackgroundOpacitySlider_OnValueChanged" />
                                    <TextBlock x:Name="BackgroundOpacityValueText" Grid.Column="1" Text="70%"
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CANVAS SIZE" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="PRESETS" Style="{StaticResource PanelLabelTextStyle}" />
                            <WrapPanel Margin="6,0,6,6">
                                <Button Content="64px" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="64px" />
                                <Button Content="128px" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="128px" />
                                <Button Content="256px" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="256px" />
                                <Button Content="512px" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="512px" />
                                <Button Content="A5" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="A5" ToolTip="148 x 210 mm" />
                                <Button Content="A4" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="A4" ToolTip="210 x 297 mm" />
                                <Button Content="A3" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="A3" ToolTip="297 x 420 mm" />
                                <Button Content="Letter" Margin="0,0,4,4" Padding="6,3" FontSize="10"
                                        Click="CanvasSizePreset_OnClick" Tag="Letter" ToolTip="215.9 x 279.4 mm" />
                            </WrapPanel>

                            <TextBlock Text="UNIT" Style="{StaticResource PanelLabelTextStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                                <RadioButton x:Name="CanvasUnitPxRadio" GroupName="CanvasSizeUnit" Content="px" IsChecked="True"
                                             Checked="CanvasSizeUnitRadio_OnChecked" Tag="Px" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="CanvasUnitCmRadio" GroupName="CanvasSizeUnit" Content="cm"
                                             Checked="CanvasSizeUnitRadio_OnChecked" Tag="Cm" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="CanvasUnitMmRadio" GroupName="CanvasSizeUnit" Content="mm"
                                             Checked="CanvasSizeUnitRadio_OnChecked" Tag="Mm"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>

                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CanvasWidthTextBox" Grid.Column="0"
                                         LostFocus="CanvasSizeTextBox_OnLostFocus" KeyDown="CanvasSizeTextBox_OnKeyDown" />
                                <TextBox x:Name="CanvasHeightTextBox" Grid.Column="2"
                                         LostFocus="CanvasSizeTextBox_OnLostFocus" KeyDown="CanvasSizeTextBox_OnKeyDown" />
                            </Grid>
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Width" FontSize="9" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Height" FontSize="9" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Design" Style="{StaticResource PanelHeaderTextStyle}" />
                <TextBlock x:Name="NoSelectionHint" Text="Draw a shape or select one to edit it."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="14,0,14,6" />
                <TextBlock x:Name="MultiSelectHint" Text="Multiple shapes selected — fill, border and effects apply to all of them."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Visibility="Collapsed"
                           TextWrapping="Wrap" Margin="14,0,14,6" />
                <Button x:Name="BringIntoViewButton" Content="⤢ Bring shape into view" Margin="14,0,14,6"
                        Visibility="Collapsed" Click="BringIntoViewButton_OnClick" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FILL &amp; COLOR" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <CheckBox x:Name="FillEnabledCheckBox" Content="FILLED" Margin="6,2,6,6"
                                      Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                      Checked="FillEnabledCheckBox_OnCheckedChanged" Unchecked="FillEnabledCheckBox_OnCheckedChanged" />
                            <StackPanel x:Name="FillColorControls">
                                <ItemsControl x:Name="SwatchList" Margin="6,0,6,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="26" Height="26" Margin="2" CornerRadius="4"
                                                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                                                    Background="{Binding}" Cursor="Hand"
                                                    MouseLeftButtonDown="FillSwatch_OnMouseLeftButtonDown" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <views:ColorPickerView x:Name="FillColorPicker" Margin="6,0,6,6" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TRANSFORM (POSITION &amp; SIZE, PX)" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="XTextBox" Grid.Row="0" Grid.Column="0" Tag="X"
                                         LostFocus="SizeTextBox_OnLostFocus" KeyDown="SizeTextBox_OnKeyDown" />
                                <TextBox x:Name="YTextBox" Grid.Row="0" Grid.Column="2" Tag="Y"
                                         LostFocus="SizeTextBox_OnLostFocus" KeyDown="SizeTextBox_OnKeyDown" />
                                <TextBox x:Name="WidthTextBox" Grid.Row="2" Grid.Column="0" Tag="Width"
                                         LostFocus="SizeTextBox_OnLostFocus" KeyDown="SizeTextBox_OnKeyDown" />
                                <TextBox x:Name="HeightTextBox" Grid.Row="2" Grid.Column="2" Tag="Height"
                                         LostFocus="SizeTextBox_OnLostFocus" KeyDown="SizeTextBox_OnKeyDown" />
                            </Grid>
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X / Y" FontSize="9" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Width / Height" FontSize="9" HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ROTATION &amp; MIRROR" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RotationTextBox" Grid.Column="0" Tag="Rotation"
                                         LostFocus="RotationTextBox_OnLostFocus" KeyDown="RotationTextBox_OnKeyDown" />
                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Stretch" Margin="2,0,0,0">
                                    <Button x:Name="RotateUpButton" Height="11" Padding="0"
                                            Click="RotateUpButton_OnClick" ToolTip="Rotate +1&#176;">
                                        <Path Data="{StaticResource RotateStepUpToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="9" Height="9" Stretch="Uniform" />
                                    </Button>
                                    <Button x:Name="RotateDownButton" Height="11" Padding="0" Margin="0,1,0,0"
                                            Click="RotateDownButton_OnClick" ToolTip="Rotate -1&#176;">
                                        <Path Data="{StaticResource RotateStepDownToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="9" Height="9" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                                <Button x:Name="FlipHorizontalButton" Grid.Column="3" Width="30" Padding="0"
                                        Click="FlipHorizontalButton_OnClick" ToolTip="Flip Horizontal">
                                    <Path Data="{StaticResource FlipHorizontalToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                          StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="FlipVerticalButton" Grid.Column="5" Width="30" Padding="0"
                                        Click="FlipVerticalButton_OnClick" ToolTip="Flip Vertical">
                                    <Path Data="{StaticResource FlipVerticalToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                          StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="RotateResetButton" Grid.Column="7" Width="30" Padding="0"
                                        Click="RotateResetButton_OnClick" ToolTip="Reset Rotation to 0°">
                                    <Path Data="{StaticResource RotateCcwToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                          StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </Grid>
                            <Grid Margin="6,0,6,6">
                                <TextBlock Text="Degrees / Flip H / Flip V / Reset" FontSize="9" HorizontalAlignment="Left"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PATH &amp; DEPTH" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="CONNECTOR STYLE" Style="{StaticResource PanelLabelTextStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                                <RadioButton x:Name="RoutingStraightRadio" GroupName="RoutingStyle" Content="Straight" IsChecked="True"
                                             Checked="RoutingStyleRadio_OnChecked" Tag="Straight" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="RoutingOrthogonalRadio" GroupName="RoutingStyle" Content="Elbow"
                                             Checked="RoutingStyleRadio_OnChecked" Tag="Orthogonal" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="RoutingRoundedRadio" GroupName="RoutingStyle" Content="Rounded"
                                             Checked="RoutingStyleRadio_OnChecked" Tag="Rounded" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="RoutingCurvedRadio" GroupName="RoutingStyle" Content="Curved"
                                             Checked="RoutingStyleRadio_OnChecked" Tag="Curved"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>

                            <TextBlock Text="LINE ENDS" Style="{StaticResource PanelLabelTextStyle}" />
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LineStartHeadComboBox" Grid.Column="0"
                                          DisplayMemberPath="Label" ToolTip="Start"
                                          SelectionChanged="LineStartHeadComboBox_OnSelectionChanged" />
                                <ComboBox x:Name="LineEndHeadComboBox" Grid.Column="2"
                                          DisplayMemberPath="Label" ToolTip="End"
                                          SelectionChanged="LineEndHeadComboBox_OnSelectionChanged" />
                            </Grid>

                            <TextBlock Text="3D DEPTH" Style="{StaticResource PanelLabelTextStyle}" />
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="Depth3DSlider" Grid.Column="0" Minimum="0" Maximum="60"
                                        ValueChanged="Depth3DSlider_OnValueChanged"
                                        PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                                <TextBlock x:Name="Depth3DValueText" Grid.Column="1" Text="0px"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BORDER" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="THICKNESS" Style="{StaticResource PanelLabelTextStyle}" />
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BorderThicknessSlider" Grid.Column="0" Minimum="0" Maximum="20"
                                        ValueChanged="BorderThicknessSlider_OnValueChanged"
                                        PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                                <TextBlock x:Name="BorderThicknessValueText" Grid.Column="1" Text="0px"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="COLOR" Style="{StaticResource PanelLabelTextStyle}" />
                            <views:ColorPickerView x:Name="BorderColorPicker" Margin="6,0,6,6" />

                            <TextBlock Text="STYLE" Style="{StaticResource PanelLabelTextStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                                <RadioButton x:Name="BorderSolidRadio" GroupName="BorderStyle" Content="Solid" IsChecked="True"
                                             Checked="BorderStyleRadio_OnChecked" Tag="Solid" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="BorderGradientRadio" GroupName="BorderStyle" Content="Gradient"
                                             Checked="BorderStyleRadio_OnChecked" Tag="Gradient" Margin="0,0,10,0"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <RadioButton x:Name="BorderFadeRadio" GroupName="BorderStyle" Content="Fade"
                                             Checked="BorderStyleRadio_OnChecked" Tag="Fade"
                                             Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <views:ColorPickerView x:Name="BorderGradientColorPicker" Margin="6,0,6,6" Visibility="Collapsed" />

                            <TextBlock Text="BORDER BLUR" Style="{StaticResource PanelLabelTextStyle}" />
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="BorderBlurSlider" Grid.Column="0" Minimum="0" Maximum="30"
                                        ValueChanged="BorderBlurSlider_OnValueChanged"
                                        PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                                <TextBlock x:Name="BorderBlurValueText" Grid.Column="1" Text="0px"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>

                            <CheckBox x:Name="DashedCheckBox" Content="DASHED" Margin="6,2,6,6"
                                      Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                      Checked="DashedCheckBox_OnCheckedChanged" Unchecked="DashedCheckBox_OnCheckedChanged" />

                            <TextBlock Text="CORNER RADIUS" Style="{StaticResource PanelLabelTextStyle}" />
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="CornerRadiusSlider" Grid.Column="0" Minimum="0" Maximum="50"
                                        ValueChanged="CornerRadiusSlider_OnValueChanged"
                                        PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                                <TextBlock x:Name="CornerRadiusValueText" Grid.Column="1" Text="0px"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="STYLE PRESETS" Style="{StaticResource PanelLabelTextStyle}" />
                            <ItemsControl x:Name="BorderPresetList" Margin="6,0,6,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="25" Height="25" Margin="2" CornerRadius="4"
                                                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                                                Background="{Binding Preview}" Cursor="Hand" ToolTip="{Binding Name}"
                                                Tag="{Binding}" MouseLeftButtonDown="BorderPreset_OnMouseLeftButtonDown" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Effects" Style="{StaticResource PanelHeaderTextStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OPACITY, BLUR &amp; SHADOW" Style="{StaticResource PanelLabelTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" Margin="0,4,10,0" />
                        </Grid>
                        <StackPanel>
                        <TextBlock Text="OPACITY" Style="{StaticResource PanelLabelTextStyle}" />
                        <Grid Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0" Maximum="100"
                                    ValueChanged="OpacitySlider_OnValueChanged"
                                    PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                            <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="BLUR" Style="{StaticResource PanelLabelTextStyle}" />
                        <Grid Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BlurSlider" Grid.Column="0" Minimum="0" Maximum="30"
                                    ValueChanged="BlurSlider_OnValueChanged"
                                    PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                            <TextBlock x:Name="BlurValueText" Grid.Column="1" Text="0px"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="FADE" Style="{StaticResource PanelLabelTextStyle}" />
                        <Grid Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FadeSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                    ValueChanged="FadeSlider_OnValueChanged"
                                    PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                            <TextBlock x:Name="FadeValueText" Grid.Column="1" Text="0%"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="FADE DIRECTION" Style="{StaticResource PanelLabelTextStyle}" />
                        <ComboBox x:Name="FadeDirectionComboBox" Margin="6,0,6,6"
                                  DisplayMemberPath="Label" ToolTip="Which way the fade runs"
                                  SelectionChanged="FadeDirectionComboBox_OnSelectionChanged" />

                        <CheckBox x:Name="ShadowCheckBox" Content="SHADOW" Margin="6,6,6,2"
                                  Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                  Checked="ShadowCheckBox_OnCheckedChanged" Unchecked="ShadowCheckBox_OnCheckedChanged" />

                        <TextBlock Text="SHADOW DISTANCE" Style="{StaticResource PanelLabelTextStyle}" />
                        <Grid Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ShadowDistanceSlider" Grid.Column="0" Minimum="0" Maximum="30"
                                    ValueChanged="ShadowDistanceSlider_OnValueChanged"
                                    PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                            <TextBlock x:Name="ShadowDistanceValueText" Grid.Column="1" Text="0px"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="SHADOW OPACITY" Style="{StaticResource PanelLabelTextStyle}" />
                        <Grid Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ShadowStrengthSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                    ValueChanged="ShadowStrengthSlider_OnValueChanged"
                                    PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                            <TextBlock x:Name="ShadowStrengthValueText" Grid.Column="1" Text="0%"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="SHADOW SHARPNESS (BLUR)" Style="{StaticResource PanelLabelTextStyle}" />
                        <Grid Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ShadowBlurSlider" Grid.Column="0" Minimum="0" Maximum="30"
                                    ValueChanged="ShadowBlurSlider_OnValueChanged"
                                    PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                            <TextBlock x:Name="ShadowBlurValueText" Grid.Column="1" Text="0px"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="SHADOW DIRECTION" Style="{StaticResource PanelLabelTextStyle}" />
                        <Grid Margin="6,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ShadowAngleSlider" Grid.Column="0" Minimum="0" Maximum="360"
                                    ValueChanged="ShadowAngleSlider_OnValueChanged"
                                    PreviewMouseLeftButtonDown="EffectSlider_OnDragStart" PreviewMouseLeftButtonUp="EffectSlider_OnDragEnd" />
                            <TextBlock x:Name="ShadowAngleValueText" Grid.Column="1" Text="45°"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="SHADOW COLOR" Style="{StaticResource PanelLabelTextStyle}" />
                        <views:ColorPickerView x:Name="ShadowColorPicker" Margin="6,0,6,6" />

                        <TextBlock Text="TEXT FONT" Style="{StaticResource PanelLabelTextStyle}" />
                        <ComboBox x:Name="TextFontFamilyComboBox" Margin="6,0,6,6"
                                  DisplayMemberPath="Label" ToolTip="Font (applies to Text shapes)"
                                  SelectionChanged="TextFontFamilyComboBox_OnSelectionChanged" />

                        <TextBlock Text="TEXT FORMAT" Style="{StaticResource PanelLabelTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="6,0,6,6">
                            <ToggleButton x:Name="TextBoldToggle" Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,4,0"
                                          Checked="TextBoldToggle_OnCheckedChanged" Unchecked="TextBoldToggle_OnCheckedChanged"
                                          ToolTip="Bold (applies to Text shapes)">
                                <Path Data="{StaticResource BoldToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </ToggleButton>
                            <ToggleButton x:Name="TextItalicToggle" Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,4,0"
                                          Checked="TextItalicToggle_OnCheckedChanged" Unchecked="TextItalicToggle_OnCheckedChanged"
                                          ToolTip="Italic (applies to Text shapes)">
                                <Path Data="{StaticResource ItalicToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </ToggleButton>
                            <ToggleButton x:Name="TextUnderlineToggle" Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,10,0"
                                          Checked="TextUnderlineToggle_OnCheckedChanged" Unchecked="TextUnderlineToggle_OnCheckedChanged"
                                          ToolTip="Underline (applies to Text shapes)">
                                <Path Data="{StaticResource UnderlineToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </ToggleButton>
                            <Path Data="{StaticResource CaseSensitiveToolGeometry}" Stroke="{StaticResource MutedTextBrush}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" ToolTip="Font Size" />
                            <TextBox x:Name="FontSizeTextBox" Width="36" VerticalContentAlignment="Center"
                                     TextAlignment="Center" ToolTip="Font Size (applies to Text shapes)"
                                     LostFocus="FontSizeTextBox_OnLostFocus" KeyDown="FontSizeTextBox_OnKeyDown" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Layers" Style="{StaticResource PanelHeaderTextStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,8,10,2">
                                <Path Data="{StaticResource LayersToolGeometry}" Stroke="{StaticResource MutedTextBrush}"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" />
                                <TextBlock Text="Document layers" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" Margin="0,4,10,0" />
                        </Grid>
                        <StackPanel>
                            <Grid Margin="6,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Click="AddLayerButton_OnClick" ToolTip="Add Layer">
                                    <Path Data="{StaticResource LayersPlusToolGeometry}" Stroke="{StaticResource ForegroundTextBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </Grid>
                            <ListBox x:Name="LayerList" Margin="6,0,6,6" MaxHeight="220"
                                     BorderThickness="0" Background="Transparent"
                                     SelectionChanged="LayerList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="14" Height="14" CornerRadius="3"
                                                        BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                                                        Background="{Binding AccentBrush}" Cursor="Hand" Tag="{Binding Layer}"
                                                        ToolTip="Layer color" MouseLeftButtonDown="LayerAccentSwatch_OnMouseLeftButtonDown" />
                                                <TextBox Grid.Column="1" Margin="6,0" BorderThickness="0" Background="Transparent"
                                                         Foreground="{StaticResource ForegroundTextBrush}"
                                                         Text="{Binding Layer.Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <ToggleButton Grid.Column="2" Width="20" Height="20" Padding="0" Margin="1,0"
                                                              IsChecked="{Binding Layer.Visible, Mode=TwoWay}"
                                                              Click="LayerToggle_OnClick" Tag="{Binding Layer}" ToolTip="Show/Hide layer">
                                                    <Grid>
                                                        <Path Data="{StaticResource EyeToolGeometry}" Stroke="{StaticResource MutedTextBrush}"
                                                              StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Layer.Visible}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <Path Data="{StaticResource EyeOffToolGeometry}" Stroke="{StaticResource MutedTextBrush}"
                                                              StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Layer.Visible}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </ToggleButton>
                                                <ToggleButton Grid.Column="3" Width="20" Height="20" Padding="0" Margin="1,0"
                                                              IsChecked="{Binding Layer.Locked, Mode=TwoWay}"
                                                              Click="LayerToggle_OnClick" Tag="{Binding Layer}" ToolTip="Lock/Unlock layer">
                                                    <Path Data="{StaticResource LockToolGeometry}" Stroke="{StaticResource MutedTextBrush}"
                                                          StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" />
                                                </ToggleButton>
                                                <Button Grid.Column="4" Content="▲" FontSize="9" Padding="4,0" Margin="2,0"
                                                        Click="LayerForward_OnClick" Tag="{Binding Layer}" />
                                                <Button Grid.Column="5" Content="▼" FontSize="9" Padding="4,0"
                                                        Click="LayerBackward_OnClick" Tag="{Binding Layer}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding ShapeItems}" Margin="20,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="4,2" Cursor="Hand" Tag="{Binding}"
                                                                MouseLeftButtonDown="ShapeItem_OnMouseLeftButtonDown">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2"
                                                                        Background="{Binding FillBrush}" />
                                                                <TextBox Grid.Column="1" Margin="6,0,0,0" FontSize="10"
                                                                         Foreground="{StaticResource MutedTextBrush}"
                                                                         BorderThickness="0" Background="Transparent" Padding="0">
                                                                    <TextBox.Text>
                                                                        <MultiBinding Converter="{StaticResource ShapeNameConverter}"
                                                                                      Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                                            <Binding Path="Shape.Name" />
                                                                            <Binding Path="DisplayName" Mode="OneWay" />
                                                                        </MultiBinding>
                                                                    </TextBox.Text>
                                                                </TextBox>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <Button Content="▲" FontSize="8" Padding="3,0" Margin="1,0"
                                                                            Click="ShapeForward_OnClick" Tag="{Binding}" ToolTip="Bring Forward" />
                                                                    <Button Content="▼" FontSize="8" Padding="3,0" Margin="1,0"
                                                                            Click="ShapeBackward_OnClick" Tag="{Binding}" ToolTip="Send Backward" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Popup x:Name="LayerAccentColorPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="6">
                                    <ItemsControl x:Name="LayerAccentColorSwatchList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="22" Height="22" Margin="2" CornerRadius="4"
                                                        BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                                                        Background="{Binding}" Cursor="Hand"
                                                        MouseLeftButtonDown="LayerAccentColorSwatch_OnMouseLeftButtonDown" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
