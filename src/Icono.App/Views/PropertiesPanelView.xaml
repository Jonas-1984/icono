<UserControl x:Class="Icono.App.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SidePanelBorderStyle}">
        <StackPanel>
            <TextBlock Text="Design" Style="{StaticResource PanelHeaderTextStyle}" />

            <TextBlock Text="FILL" Style="{StaticResource PanelLabelTextStyle}" />
            <ItemsControl x:Name="SwatchList" Margin="10,0,10,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="26" Height="26" Margin="2" CornerRadius="4"
                                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                                Background="{Binding}" Cursor="Hand" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="COLOR (HUE)" Style="{StaticResource PanelLabelTextStyle}" />
            <Grid Margin="10,0,10,6">
                <Border Height="6" CornerRadius="3" Background="{StaticResource RainbowHueBrush}" />
                <Slider Style="{StaticResource HueSliderStyle}" Minimum="0" Maximum="360" Value="0" />
            </Grid>

            <TextBlock Text="BORDER THICKNESS" Style="{StaticResource PanelLabelTextStyle}" />
            <Grid Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="0" Maximum="20" Value="2"
                        ValueChanged="BorderThicknessSlider_OnValueChanged" />
                <TextBlock x:Name="BorderThicknessValueText" Grid.Column="1" Text="2px"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="CORNER RADIUS" Style="{StaticResource PanelLabelTextStyle}" />
            <Grid Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="0" Maximum="50" Value="0"
                        ValueChanged="CornerRadiusSlider_OnValueChanged" />
                <TextBlock x:Name="CornerRadiusValueText" Grid.Column="1" Text="0px"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="BORDER STYLE" Style="{StaticResource PanelLabelTextStyle}" />
            <ItemsControl x:Name="BorderPresetList" Margin="10,0,10,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <Border Height="28" CornerRadius="5"
                                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1"
                                    Background="{Binding Preview}" Cursor="Hand" />
                            <TextBlock Text="{Binding Name}" FontSize="9"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="TEXT FORMAT" Style="{StaticResource PanelLabelTextStyle}" />
            <ComboBox Margin="10,0,10,6" IsEnabled="False">
                <ComboBoxItem Content="Default" IsSelected="True" />
            </ComboBox>
        </StackPanel>
    </Border>
</UserControl>
