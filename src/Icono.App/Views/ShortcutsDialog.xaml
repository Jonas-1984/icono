<local:ThemedDialogWindow x:Class="Icono.App.Views.ShortcutsDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Icono.App.Views"
                          Title="Keyboard shortcuts">
    <local:DialogCard Title="Keyboard shortcuts" Width="520">
        <StackPanel>
            <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ShortcutList" Margin="0,0,12,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Action}" Foreground="{DynamicResource ForegroundTextBrush}" />
                                <Border Grid.Column="1" CornerRadius="3.5" Padding="9,2" Background="{DynamicResource InsetBrush}"
                                        BorderBrush="{DynamicResource InsetEdgeBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Keys}" FontSize="11" Foreground="{DynamicResource AccentBlueLightBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Content="Close" MinWidth="92" Height="32" HorizontalAlignment="Right" Margin="0,18,0,0"
                    IsDefault="True" IsCancel="True" Click="CloseButton_OnClick" />
        </StackPanel>
    </local:DialogCard>
</local:ThemedDialogWindow>
