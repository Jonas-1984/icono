<Window x:Class="Icono.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About icono" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        KeyDown="Window_OnKeyDown">
    <!-- Transparent outer window leaves room for the neumorphic drop shadows around the card. -->
    <Grid Margin="22">
        <Border Style="{DynamicResource NeuShadowLightStyle}" CornerRadius="10" />
        <Border Style="{DynamicResource NeuShadowDarkStyle}" CornerRadius="10" />
        <Border CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                MouseLeftButtonDown="Card_OnMouseLeftButtonDown">
            <StackPanel Margin="28,26,28,24">
                <!-- App logo (it already is a rounded neumorphic tile with its own cyan glow) -->
                <Image Source="/Assets/icono.png" Width="120" Height="120" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Text="icono" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{DynamicResource ForegroundTextBrush}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Icon &amp; Floor Plan Editor" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Foreground="{DynamicResource AccentBlueMidBrush}" FontSize="13" />

                <Border Margin="0,18,0,0" CornerRadius="7" Padding="14,10"
                        Background="{DynamicResource InsetBrush}"
                        BorderBrush="{DynamicResource InsetEdgeBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Version" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="VersionText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Platform" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="PlatformText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" CornerRadius="3.5" Padding="14,10"
                        Background="{DynamicResource InsetBrush}"
                        BorderBrush="{DynamicResource InsetEdgeBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Design &amp; Development" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="Jonas Shojaei" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Built with" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="Claude (Anthropic)" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Website" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12">
                                <Hyperlink NavigateUri="https://www.bitbins.de" RequestNavigate="Hyperlink_OnRequestNavigate"
                                           Foreground="{DynamicResource AccentBlueMidBrush}" ToolTip="Open www.bitbins.de">www.bitbins.de</Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="E-mail" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12">
                                <Hyperlink NavigateUri="mailto:info@bitbins.de" RequestNavigate="Hyperlink_OnRequestNavigate"
                                           Foreground="{DynamicResource AccentBlueMidBrush}" ToolTip="Write to info@bitbins.de">info@bitbins.de</Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2026 Jonas Shojaei · bitbins.de" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />

                <Button Content="OK" Width="110" HorizontalAlignment="Center" Margin="0,22,0,0"
                        Padding="10,6" IsDefault="True" IsCancel="True" Click="OkButton_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
