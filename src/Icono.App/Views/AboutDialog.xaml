<Window x:Class="Icono.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About icono" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        KeyDown="Window_OnKeyDown">
    <!-- Transparent outer window leaves room for the neumorphic drop shadows around the card. -->
    <Grid Margin="22">
        <Border Style="{DynamicResource NeuShadowLightStyle}" CornerRadius="10" />
        <Border Style="{DynamicResource NeuShadowDarkStyle}" CornerRadius="10" />
        <Border CornerRadius="10" BorderThickness="1"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                MouseLeftButtonDown="Card_OnMouseLeftButtonDown">
            <StackPanel Margin="28,26,28,24">
                <!-- App logo (set in the code: the dark designs get a brighter blue) -->
                <Image x:Name="LogoImage" Width="280" Height="120" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="icono" />
                <TextBlock Text="Design Made Simple" HorizontalAlignment="Center" Margin="0,8,0,0" FontStyle="Italic"
                           Foreground="{DynamicResource AccentBlueMidBrush}" FontSize="13" />

                <Border Margin="0,18,0,0" CornerRadius="7" Padding="14,10"
                        Background="{DynamicResource InsetBrush}"
                        BorderBrush="{DynamicResource InsetEdgeBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Version" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="VersionText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Platform" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="PlatformText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" CornerRadius="3.5" Padding="14,10"
                        Background="{DynamicResource InsetBrush}"
                        BorderBrush="{DynamicResource InsetEdgeBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Design &amp; Development" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="Jonas Shojaei" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Built with" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="Claude (Anthropic)" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource ForegroundTextBrush}" FontSize="12" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Website" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12">
                                <Hyperlink NavigateUri="https://www.bitbins.de" RequestNavigate="Hyperlink_OnRequestNavigate"
                                           Foreground="{DynamicResource AccentBlueMidBrush}" ToolTip="Open www.bitbins.de">www.bitbins.de</Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="E-mail" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12">
                                <Hyperlink NavigateUri="mailto:info@bitbins.de" RequestNavigate="Hyperlink_OnRequestNavigate"
                                           Foreground="{DynamicResource AccentBlueMidBrush}" ToolTip="Write to info@bitbins.de">info@bitbins.de</Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="Licenses" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12">
                                <Hyperlink Click="LicensesLink_OnClick" Foreground="{DynamicResource AccentBlueMidBrush}"
                                           ToolTip="Lucide icons (ISC / MIT), SkiaSharp and Skia (MIT / BSD), .NET (MIT)">Third-party notices</Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- What every user should know (the full texts are the documents linked below) -->
                <Border Margin="0,10,0,0" CornerRadius="3.5" Padding="14,10"
                        Background="{DynamicResource InsetBrush}"
                        BorderBrush="{DynamicResource InsetEdgeBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="GOOD TO KNOW" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundTextBrush}">
                            <Run FontWeight="SemiBold" Text="Test version. " /><Run Text="icono is not finished and can contain errors. Back up your drawings regularly." />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundTextBrush}">
                            <Run FontWeight="SemiBold" Text="Privacy. " /><Run Text="icono sends no data and needs no internet. Settings, recent files and the error log stay on this PC in %LocalAppData%\Icono." />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundTextBrush}">
                            <Run FontWeight="SemiBold" Text="Your drawings. " /><Run Text="They belong to you and are saved only where you choose. Do not put personal data of others into drawings you pass on." />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundTextBrush}">
                            <Run FontWeight="SemiBold" Text="Dimensions and plans " /><Run Text="are aids, not a building document: check them before you build, buy or install anything." />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForegroundTextBrush}">
                            <Run FontWeight="SemiBold" Text="Files from outside " /><Run Text="(SVG, pictures, documents) are read with safety limits. Open only files you trust." />
                        </TextBlock>
                        <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                            <TextBlock FontSize="12" Margin="8,0">
                                <Hyperlink Click="ManualLink_OnClick" Foreground="{DynamicResource AccentBlueMidBrush}"
                                           ToolTip="Open the user manual (no internet needed)">User manual</Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="8,0">
                                <Hyperlink Click="TermsLink_OnClick" Foreground="{DynamicResource AccentBlueMidBrush}"
                                           ToolTip="The terms of the test version">Test terms</Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="12" Margin="8,0">
                                <Hyperlink Click="PrivacyLink_OnClick" Foreground="{DynamicResource AccentBlueMidBrush}"
                                           ToolTip="What icono stores and what it does not">Privacy notice</Hyperlink>
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2026 Jonas Shojaei · bitbins.de" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />

                <Button Content="OK" Width="110" HorizontalAlignment="Center" Margin="0,22,0,0"
                        Padding="10,6" IsDefault="True" IsCancel="True" Click="OkButton_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
