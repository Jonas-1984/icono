<UserControl x:Class="Icono.App.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource StatusBarBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Zoom:" Foreground="{DynamicResource ForegroundTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0.1" Maximum="8.0" Value="1.0"
                    VerticalAlignment="Center" ValueChanged="ZoomSlider_OnValueChanged" />
            <TextBlock x:Name="ZoomLabel" Grid.Column="2" Text="100%"
                       Foreground="{DynamicResource ForegroundTextBrush}"
                       VerticalAlignment="Center" Margin="6,0,0,0" Width="40" />
            <TextBlock x:Name="ScaleText" Grid.Column="3" Text="Scale 1:1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" ToolTip="Drawing scale. Change it in Design > Scale or in the Canvas card." />
            <TextBlock x:Name="StatusMessageText" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource AccentBlueLightBrush}" Opacity="0" />
        </Grid>
    </Border>
</UserControl>
