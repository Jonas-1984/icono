<UserControl x:Class="Icono.App.Views.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="36"
             Background="Transparent">
    <UserControl.Resources>
        <PathGeometry x:Key="CaptionMinimizeGeometry" Figures="M0,5 L10,5" />
        <PathGeometry x:Key="CaptionMaximizeGeometry" Figures="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
        <GeometryGroup x:Key="CaptionRestoreGeometry">
            <RectangleGeometry Rect="2,0.5,7.5,7.5" />
            <RectangleGeometry Rect="0.5,2,7.5,7.5" />
        </GeometryGroup>
        <PathGeometry x:Key="CaptionCloseGeometry" Figures="M0,0 L10,10 M10,0 L0,10" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Width="20" Height="20" Margin="10,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
               VerticalAlignment="Center"
               Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" />

        <TextBlock x:Name="TitleText" Grid.Column="1" Text="icono" VerticalAlignment="Center"
                   Foreground="{DynamicResource ForegroundTextBrush}"
                   FontSize="12" FontWeight="SemiBold" />

        <!-- Column 2 is empty draggable space (moves the window). -->

        <!-- Our own Minimize/Maximize-Restore/Close buttons — WindowChrome otherwise treats this
             whole row as non-client "caption" (drag-to-move), so it must opt back into normal
             hit-testing to be clickable. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                    Click="MinimizeButton_OnClick" ToolTip="Minimize">
                <Path Data="{StaticResource CaptionMinimizeGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Uniform" />
            </Button>
            <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButtonStyle}"
                    Click="MaximizeRestoreButton_OnClick" ToolTip="Maximize">
                <Path x:Name="MaximizeRestoreIcon" Data="{StaticResource CaptionMaximizeGeometry}"
                      Stroke="{DynamicResource ForegroundTextBrush}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Uniform" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButtonStyle}"
                    Click="CloseButton_OnClick" ToolTip="Close">
                <Path Data="{StaticResource CaptionCloseGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
