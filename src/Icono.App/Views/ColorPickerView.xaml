<UserControl x:Class="Icono.App.Views.ColorPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Width="180" Height="120" ClipToBounds="True">
            <Border x:Name="HueBaseLayer" CornerRadius="4" />
            <Border CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas x:Name="SvCanvas" Background="Transparent"
                    MouseDown="SvCanvas_OnMouseDown" MouseMove="SvCanvas_OnMouseMove" MouseUp="SvCanvas_OnMouseUp">
                <Ellipse x:Name="SvThumb" Width="12" Height="12" StrokeThickness="2"
                         Stroke="White" IsHitTestVisible="False" />
            </Canvas>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Border Height="6" CornerRadius="3" Background="{StaticResource RainbowHueBrush}" />
            <Slider x:Name="HueSlider" Style="{StaticResource HueSliderStyle}"
                    Minimum="0" Maximum="360" ValueChanged="HueSlider_OnValueChanged" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="AlphaSlider" Grid.Column="0" Minimum="0" Maximum="100"
                    ValueChanged="AlphaSlider_OnValueChanged" ToolTip="Opacity of this color (transparent fill/border)" />
            <TextBlock x:Name="AlphaValueText" Grid.Column="1" Text="100%"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush x:Name="PreviewBrush" />
                </Border.Background>
            </Border>
            <TextBox x:Name="HexTextBox" Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     LostFocus="HexTextBox_OnLostFocus" KeyDown="HexTextBox_OnKeyDown" />
        </Grid>
    </StackPanel>
</UserControl>
