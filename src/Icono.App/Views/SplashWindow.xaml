<Window x:Class="Icono.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="icono" Width="640" Height="420" Icon="/Assets/icono.ico"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="icono is starting"
        ContentRendered="Window_OnContentRendered" MouseLeftButtonDown="Window_OnMouseLeftButtonDown" KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <!-- Everything is faded in one after the other; the line starts after the sentence and fills in the rest of the six seconds. -->
        <Storyboard x:Key="Intro">
            <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoImage" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" From="32" To="0" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" From="0.88" To="1" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" From="0.88" To="1" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="NameText" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.9" Duration="0:0:0.9" />
            <DoubleAnimation Storyboard.TargetName="NameShift" Storyboard.TargetProperty="Y" From="10" To="0" BeginTime="0:0:0.9" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="TaglineText" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.5" Duration="0:0:0.9" />

            <DoubleAnimation Storyboard.TargetName="ProgressArea" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:2.0" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="ProgressScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" BeginTime="0:0:2.0" Duration="0:0:3.8" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="Card" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Image x:Name="LogoImage" Source="/Assets/icono.png" Width="128" Height="128" Opacity="0"
                       RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                    <Image.Effect>
                        <BlurEffect Radius="32" KernelType="Gaussian" />
                    </Image.Effect>
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.88" ScaleY="0.88" />
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="NameText" HorizontalAlignment="Center" Margin="0,22,0,0" FontSize="36" FontWeight="Light" Opacity="0"
                           AutomationProperties.Name="ICONO">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="NameShift" Y="10" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="TaglineText" Text="Design Made Simple" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="15"
                           FontStyle="Italic" Opacity="0" />
            </StackPanel>

            <Grid x:Name="ProgressArea" Grid.Row="1" Margin="56,0,56,44" Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Track" Grid.Column="0" Height="4" CornerRadius="2" VerticalAlignment="Center" ClipToBounds="True">
                    <Border x:Name="Fill" CornerRadius="2" Background="{DynamicResource GlossyBlueBrushHorizontal}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" Width="48" TextAlignment="Right" Margin="14,0,0,0"
                           VerticalAlignment="Center" FontSize="13" AutomationProperties.Name="Loading progress" />
            </Grid>
        </Grid>
    </Border>
</Window>
