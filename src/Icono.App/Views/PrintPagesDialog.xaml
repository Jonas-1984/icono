<local:ThemedDialogWindow x:Class="Icono.App.Views.PrintPagesDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Icono.App.Views"
                          Title="Print pages">
    <local:DialogCard Title="Print pages" Width="380">
        <StackPanel>
            <TextBlock Text="PAGES" Style="{StaticResource PanelLabelTextStyle}" Margin="0,0,0,6" />
            <RadioButton x:Name="AllRadio" GroupName="PrintPages" IsChecked="True" Margin="0,0,0,8"
                         Foreground="{DynamicResource ForegroundTextBrush}" Checked="Radio_OnChecked" />
            <RadioButton x:Name="CurrentRadio" GroupName="PrintPages" Margin="0,0,0,8"
                         Foreground="{DynamicResource ForegroundTextBrush}" Checked="Radio_OnChecked" />
            <RadioButton x:Name="RangeRadio" GroupName="PrintPages" Content="Pages:" Margin="0,0,0,6"
                         Foreground="{DynamicResource ForegroundTextBrush}" Checked="Radio_OnChecked" />
            <TextBox x:Name="RangeTextBox" Height="32" Text="1" IsEnabled="False" GotFocus="RangeTextBox_OnGotFocus"
                     ToolTip="For example 1,3-5 (page 1, and pages 3 to 5)" />
            <TextBlock x:Name="InfoText" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Text="Every page is printed on its own sheet. Type pages like 1,3-5." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" MinWidth="92" Height="32" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_OnClick" />
                <Button Content="Print..." MinWidth="100" Height="32" IsDefault="True" Click="PrintButton_OnClick" />
            </StackPanel>
        </StackPanel>
    </local:DialogCard>
</local:ThemedDialogWindow>
