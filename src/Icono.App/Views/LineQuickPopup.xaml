<UserControl x:Class="Icono.App.Views.LineQuickPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Floating card that appears next to a clicked line/arrow: the line's form (straight / elbow / rounded / curved)
         and the shape of both line ends. Same glass surface as the menus. -->
    <Grid Margin="0,0,10,12" MouseDown="Card_OnMouseDown" MouseUp="Card_OnMouseDown">
    <!-- shadow on a separate backdrop so the card's text is never run through the effect -->
    <Border Background="{DynamicResource PopupSurfaceBrush}" CornerRadius="7" Effect="{DynamicResource RaisedDarkShadow}" />
    <Border Background="{DynamicResource PopupSurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
            BorderThickness="1" CornerRadius="7" Padding="12,10,12,12" SnapsToDevicePixels="True">
        <StackPanel Width="232">
            <UniformGrid x:Name="FormRow" Rows="1" Columns="4" HorizontalAlignment="Center">
                <ToggleButton x:Name="StraightToggle" Tag="Straight" ToolTip="Straight line" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,6,0">
                    <Path Data="M3,13 L13,3" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource ForegroundTextBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
                <ToggleButton x:Name="ElbowToggle" Tag="Orthogonal" ToolTip="Elbow (right angles)" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,6,0">
                    <Path Data="M3,13 H8 V3 H13" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource ForegroundTextBrush}"
                          StrokeThickness="1.6" StrokeLineJoin="Miter" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
                <ToggleButton x:Name="RoundedToggle" Tag="Rounded" ToolTip="Rounded elbow" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,6,0">
                    <Path Data="M3,13 H5.5 Q8,13 8,10.5 V5.5 Q8,3 10.5,3 H13" Width="16" Height="16" Stretch="Uniform"
                          Stroke="{DynamicResource ForegroundTextBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
                <ToggleButton x:Name="CurvedToggle" Tag="Curved" ToolTip="Curved line" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}">
                    <Path Data="M3,13 C9,13 7,3 13,3" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource ForegroundTextBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
            </UniformGrid>

            <!-- the numbers: thickness and length of the line, corner radius and 3D depth (the same settings as the right panel) -->
            <Grid x:Name="NumbersGrid" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="ThicknessBox" Grid.Row="0" Grid.Column="0" Height="26" TextAlignment="Center" Tag="Thickness"
                         AutomationProperties.Name="Line thickness in cm" ToolTip="Thickness of the line in cm on the page. Type a number and press Enter."
                         LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                <TextBox x:Name="LengthBox" Grid.Row="0" Grid.Column="2" Height="26" TextAlignment="Center" Tag="Length"
                         AutomationProperties.Name="Line length in cm" ToolTip="Length of the line in cm (real length at the drawing scale). Type a number and press Enter."
                         LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Thickness (cm)" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Length (cm)" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox x:Name="RadiusBox" Grid.Row="2" Grid.Column="0" Height="26" Margin="0,8,0,0" TextAlignment="Center" Tag="Radius"
                         AutomationProperties.Name="Corner radius in cm" ToolTip="Radius of the corners in cm (0 = sharp). Type a number and press Enter."
                         LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                <TextBox x:Name="DepthBox" Grid.Row="2" Grid.Column="2" Height="26" Margin="0,8,0,0" TextAlignment="Center" Tag="Depth"
                         AutomationProperties.Name="3D depth in px" ToolTip="3D depth in px (0 = flat). Type a number and press Enter."
                         LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                <TextBlock x:Name="RadiusLabel" Grid.Row="3" Grid.Column="0" Text="Corner radius (cm)" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="DepthLabel" Grid.Row="3" Grid.Column="2" Text="3D depth (px)" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>

            <!-- dashed stroke -->
            <CheckBox x:Name="DashedCheckBox" Content="Dashed" Margin="2,12,0,0" FontSize="11" Foreground="{DynamicResource ForegroundTextBrush}"
                      Click="DashedCheckBox_OnClick" />

            <TextBlock x:Name="LineEndTitle" Text="Line End" FontWeight="SemiBold" FontSize="12" Margin="2,12,0,6"
                       Foreground="{DynamicResource ForegroundTextBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="StartHeadComboBox" Grid.Row="0" Grid.Column="0" DisplayMemberPath="Label"
                          ToolTip="Shape of the line's start" SelectionChanged="StartHeadComboBox_OnSelectionChanged" />
                <ComboBox x:Name="EndHeadComboBox" Grid.Row="0" Grid.Column="2" DisplayMemberPath="Label"
                          ToolTip="Shape of the line's end" SelectionChanged="EndHeadComboBox_OnSelectionChanged" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Start" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="End" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
