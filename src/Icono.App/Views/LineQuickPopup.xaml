<UserControl x:Class="Icono.App.Views.LineQuickPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Floating card that appears next to a clicked line / arrow / loop arrow: its form, the numbers (thickness, length, head size, corner radius, depth),
         dashed / sketch and the shape of both line ends. Kept small: short labels, three boxes in a row. -->
    <Grid Margin="0,0,10,12" MouseDown="Card_OnMouseDown" MouseUp="Card_OnMouseDown">
    <!-- shadow on a separate backdrop so the card's text is never run through the effect -->
    <Border Background="{DynamicResource PopupSurfaceBrush}" CornerRadius="7" Effect="{DynamicResource RaisedDarkShadow}" />
    <Border Background="{DynamicResource PopupSurfaceBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}"
            BorderThickness="1" CornerRadius="7" Padding="9,8,9,9" SnapsToDevicePixels="True">
        <StackPanel Width="192">
            <UniformGrid x:Name="FormRow" Rows="1" Columns="4" HorizontalAlignment="Center">
                <ToggleButton x:Name="StraightToggle" Tag="Straight" ToolTip="Straight line" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,5,0">
                    <Path Data="M3,13 L13,3" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource ForegroundTextBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
                <ToggleButton x:Name="ElbowToggle" Tag="Orthogonal" ToolTip="Elbow (right angles)" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,5,0">
                    <Path Data="M3,13 H8 V3 H13" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource ForegroundTextBrush}"
                          StrokeThickness="1.6" StrokeLineJoin="Miter" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
                <ToggleButton x:Name="RoundedToggle" Tag="Rounded" ToolTip="Rounded elbow" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}" Margin="0,0,5,0">
                    <Path Data="M3,13 H5.5 Q8,13 8,10.5 V5.5 Q8,3 10.5,3 H13" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource ForegroundTextBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
                <ToggleButton x:Name="CurvedToggle" Tag="Curved" ToolTip="Curved line" Click="StyleToggle_OnClick"
                              Style="{StaticResource IconToggleButtonStyle}">
                    <Path Data="M3,13 C9,13 7,3 13,3" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource ForegroundTextBrush}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </ToggleButton>
            </UniformGrid>

            <!-- the numbers, three in a row (the settings of the right panel): boxes that do not apply (corner radius of a loop) leave no gap -->
            <WrapPanel x:Name="NumbersGrid" Margin="0,8,0,0">
                <StackPanel Width="64">
                    <TextBox x:Name="ThicknessBox" Height="24" Margin="0,0,4,0" FontSize="11" TextAlignment="Center" Tag="Thickness"
                             AutomationProperties.Name="Line thickness in cm" ToolTip="Thickness of the line in cm on the page. Type a number and press Enter."
                             LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                    <TextBlock Text="Thick cm" FontSize="9" HorizontalAlignment="Center" Margin="0,2,4,5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Width="64">
                    <TextBox x:Name="LengthBox" Height="24" Margin="0,0,4,0" FontSize="11" TextAlignment="Center" Tag="Length"
                             AutomationProperties.Name="Line length in cm" ToolTip="Length of the line in cm (real length at the drawing scale). Type a number and press Enter."
                             LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                    <TextBlock Text="Length cm" FontSize="9" HorizontalAlignment="Center" Margin="0,2,4,5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Width="64">
                    <TextBox x:Name="HeadBox" Height="24" FontSize="11" TextAlignment="Center" Tag="Head"
                             AutomationProperties.Name="Arrow head size in px" ToolTip="Size of the arrow heads in px (both ends). Type a number and press Enter."
                             LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                    <TextBlock Text="Head px" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel x:Name="RadiusItem" Width="64">
                    <TextBox x:Name="RadiusBox" Height="24" Margin="0,0,4,0" FontSize="11" TextAlignment="Center" Tag="Radius"
                             AutomationProperties.Name="Corner radius in cm" ToolTip="Radius of the corners in cm (0 = sharp). Type a number and press Enter."
                             LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                    <TextBlock Text="Radius cm" FontSize="9" HorizontalAlignment="Center" Margin="0,2,4,5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Width="64">
                    <TextBox x:Name="DepthBox" Height="24" Margin="0,0,4,0" FontSize="11" TextAlignment="Center" Tag="Depth"
                             AutomationProperties.Name="3D depth in px" ToolTip="3D depth in px (0 = flat). Type a number and press Enter."
                             LostFocus="NumberBox_OnLostFocus" KeyDown="NumberBox_OnKeyDown" />
                    <TextBlock Text="Depth px" FontSize="9" HorizontalAlignment="Center" Margin="0,2,4,5" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <CheckBox x:Name="DashedCheckBox" Content="Dashed" Margin="0,0,14,0" FontSize="11" Foreground="{DynamicResource ForegroundTextBrush}"
                          Click="DashedCheckBox_OnClick" ToolTip="Dashed stroke" />
                <CheckBox x:Name="SketchCheckBox" Content="Sketch" FontSize="11" Foreground="{DynamicResource ForegroundTextBrush}"
                          Click="SketchCheckBox_OnClick" ToolTip="Drawn like by hand: a wobbling pen line that starts thin" />
            </StackPanel>

            <TextBlock x:Name="LineEndTitle" Text="Ends" FontWeight="SemiBold" FontSize="11" Margin="2,8,0,4"
                       Foreground="{DynamicResource ForegroundTextBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="StartHeadComboBox" Grid.Row="0" Grid.Column="0" DisplayMemberPath="Short" FontSize="11"
                          ToolTip="Shape of the line start" SelectionChanged="StartHeadComboBox_OnSelectionChanged" />
                <ComboBox x:Name="EndHeadComboBox" Grid.Row="0" Grid.Column="2" DisplayMemberPath="Short" FontSize="11"
                          ToolTip="Shape of the line end" SelectionChanged="EndHeadComboBox_OnSelectionChanged" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Start" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="End" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
