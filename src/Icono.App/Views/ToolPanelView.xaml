<UserControl x:Class="Icono.App.Views.ToolPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Icono.App.Views">
    <Border Style="{StaticResource SidePanelBorderStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Tools" Style="{StaticResource PanelHeaderTextStyle}" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <WrapPanel Margin="6,0">
                        <RadioButton x:Name="SelectToolRadioButton" GroupName="ToolSelection" IsChecked="True"
                                     Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource SelectToolGeometry}" CommandParameter="Select" ToolTip="Select" />
                        <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource PanZoomToolGeometry}" CommandParameter="PanZoom" ToolTip="Pan / Zoom" />
                        <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource EyedropperToolGeometry}" CommandParameter="Eyedropper"
                                     ToolTip="Eyedropper (I): take a colour from the page" />
                        <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource RegionColorToolGeometry}" CommandParameter="RegionColor"
                                     ToolTip="Region Color (G): click a closed area to colour just that piece" />
                        <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource AddPointToolGeometry}" CommandParameter="AddPoint"
                                     ToolTip="Add Point (click a segment's midpoint on the selected line/shape)" />
                        <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource DeletePointToolGeometry}" CommandParameter="DeletePoint"
                                     ToolTip="Delete Point (click a point on the selected line/shape)" />
                        <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource MatchToolGeometry}" CommandParameter="Match"
                                     ToolTip="Match (Q): click the object whose look you want, then click the objects that should get it" />
                    </WrapPanel>
                </Border>

                <Border x:Name="PointSnapCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OBJECT SNAP (F3)" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Every tool - lines, shapes, walls, dimensions, handles and moved objects - snaps to these points of all objects. A mark shows what was found. Hold Alt to snap off."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,6" />
                            <CheckBox x:Name="PointSnapEnabledCheckBox" Content="Object snap on" Tag="Enabled" IsChecked="True" Click="PointSnapCheckBox_OnClick"
                                      Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="10,2,6,4"
                                      ToolTip="Master switch (F3). Hold Alt to snap off for one click." />
                            <StackPanel x:Name="PointSnapList" Margin="10,0,6,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ALIGN WHILE MOVING" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Shapes line up with the faces of walls and the edges of other shapes while you move, place or resize them: put a cabinet right against a wall. Hold Alt to snap off."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,6" />
                            <StackPanel Margin="10,0,6,6">
                                <CheckBox x:Name="ObjectSnapEnabledCheckBox" Content="Align shapes" Tag="Enabled" IsChecked="True" Click="ObjectSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Master switch. Hold Alt to snap off for one move." />
                                <CheckBox x:Name="ObjectSnapWallsCheckBox" Content="To wall faces and corners" Tag="Walls" IsChecked="True" Click="ObjectSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="12,2,0,2"
                                          ToolTip="Both sides of every straight wall: the edge of the shape stops exactly on the face of the wall." />
                                <CheckBox x:Name="ObjectSnapObjectsCheckBox" Content="To other shapes (edges, centres)" Tag="Objects" IsChecked="True" Click="ObjectSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="12,2,0,2"
                                          ToolTip="Line up with, or sit flush against, the edges and centres of other shapes." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MATCH (Q)" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Select the source (or click it), then click every object that should take over its look. Esc ends. Each click is one undo step."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,6" />
                            <TextBlock Text="CARRY OVER" Style="{StaticResource PanelLabelTextStyle}" />
                            <StackPanel Margin="10,0,6,6">
                                <CheckBox Content="Fill and colour" Tag="Fill" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2" />
                                <CheckBox Content="Border / line" Tag="Border" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Colour, thickness, style, gradient and blur of the border or line" />
                                <CheckBox Content="Effects" Tag="Effects" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Opacity, blur, fade and shadow" />
                                <CheckBox Content="Corners and design style" Tag="Form" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Corner radius, design style (glass, neumorphism ...) and 3D depth" />
                                <CheckBox Content="Text" Tag="Text" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Font, size, style and colour (not the words)" />
                                <CheckBox Content="Line ends and dash" Tag="Line" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Dashed stroke and the markers at the ends of a line" />
                                <CheckBox Content="Wall (thickness, hatch)" Tag="Wall" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2" />
                                <CheckBox Content="Dimension style" Tag="Dimension" IsChecked="True" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Text size, line width, end marks and number position of dimensions (also of a wall's dimensions)" />
                                <CheckBox Content="Size (width and height)" Tag="Size" Click="MatchAspectCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Make the object as big as the source. Position and rotation stay." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WALLS" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <WrapPanel Margin="6,0">
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource WallToolGeometry}" CommandParameter="Wall"
                                             ToolTip="Draw a wall (W): click the corners, click the start point again to close the room, double-click or Enter to finish" />
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource CutWallToolGeometry}" CommandParameter="WallCut"
                                             ToolTip="Cut a wall (X): click the place where it should be split" />
                            </WrapPanel>
                            <Button Content="Close room" Style="{StaticResource PanelKeyButtonStyle}" Margin="6,4,6,2" Click="CloseRoom_OnClick"
                                    ToolTip="Select an open wall, then click here: its last corner is joined to its first one by a new wall and the wall becomes a closed room. While drawing you can also click the start point again." />
                            <TextBlock Text="ROOMS" Style="{StaticResource PanelLabelTextStyle}" />
                            <WrapPanel Margin="6,0,6,2">
                                <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="Room_OnClick" Tag="Closed" ToolTip="Closed room">
                                    <Path Data="{StaticResource RoomClosedToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="Room_OnClick" Tag="OneCorner" ToolTip="Room with one corner (L-shape)">
                                    <Path Data="{StaticResource RoomOneCornerToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="Room_OnClick" Tag="OneSlantedWall" ToolTip="Room with one slanted wall">
                                    <Path Data="{StaticResource RoomOneSlantToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="Room_OnClick" Tag="TwoSlantedWalls" ToolTip="Room with two slanted walls">
                                    <Path Data="{StaticResource RoomTwoSlantsToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="Room_OnClick" Tag="CornerColumn" ToolTip="Room with a column in a corner (that side has three corners)">
                                    <Path Data="{StaticResource RoomCornerColumnToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource ToolbarSquareIconButtonStyle}" Click="Room_OnClick" Tag="WallColumn" ToolTip="Room with a column against a wall">
                                    <Path Data="{StaticResource RoomWallColumnToolGeometry}" Stroke="{DynamicResource ForegroundTextBrush}"
                                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" />
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="A room is added in the middle of the page as one closed wall. Click the number of any wall to type its length." Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,8" />
                            <TextBlock Text="Pick a wall, then set thickness, hatch and dimensions in the WALL card on the right."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,8" />
                            <TextBlock Text="SNAPPING" Style="{StaticResource PanelLabelTextStyle}" />
                            <StackPanel Margin="10,0,6,2">
                                <CheckBox Content="Snap while drawing walls" Tag="Enabled" IsChecked="True" Click="WallSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" Margin="0,2"
                                          ToolTip="Master switch for all wall snapping. Hold Alt to snap off for one click." />
                                <CheckBox Content="Horizontal / vertical" Tag="Axis" IsChecked="True" Click="WallSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="12,2,0,2"
                                          ToolTip="Snap to the horizontal and vertical direction from the last point. Hold Shift to force it." />
                                <CheckBox Content="Line up with other points" Tag="Align" IsChecked="True" Click="WallSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="12,2,0,2"
                                          ToolTip="Guide lines show when a point is in a row (horizontal or vertical) with another point, so facing walls sit exactly opposite each other." />
                                <CheckBox Content="Equal length" Tag="EqualLength" IsChecked="True" Click="WallSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="12,2,0,2"
                                          ToolTip="Snap the length of the new wall to the length of another wall segment." />
                                <CheckBox Content="Parallel / perpendicular" Tag="Parallel" IsChecked="True" Click="WallSnapCheckBox_OnClick"
                                          Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="12,2,0,2"
                                          ToolTip="Snap to walls that run parallel or at a right angle to an existing wall." />
                            </StackPanel>
                            <TextBlock Text="Shift forces horizontal / vertical. Alt switches snapping off while held."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DIMENSIONS &amp; SIZE" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="MEASURE (D)" Style="{StaticResource PanelLabelTextStyle}" />
                            <WrapPanel Margin="6,0">
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource DimAlignedToolGeometry}" CommandParameter="DimAligned"
                                             ToolTip="Aligned dimension: click both points, then where the dimension line should run" />
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource DimHorizontalToolGeometry}" CommandParameter="DimHorizontal"
                                             ToolTip="Horizontal dimension: click both points, then the height of the line" />
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource DimVerticalToolGeometry}" CommandParameter="DimVertical"
                                             ToolTip="Vertical dimension: click both points, then the position of the line" />
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource DimAngularToolGeometry}" CommandParameter="DimAngular"
                                             ToolTip="Angle: click the corner, a point on each side, then where the arc should run" />
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource DimRadiusToolGeometry}" CommandParameter="DimRadius"
                                             ToolTip="Radius: click the centre, then a point on the circle" />
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource DimDiameterToolGeometry}" CommandParameter="DimDiameter"
                                             ToolTip="Diameter: click the centre, then a point on the circle" />
                            </WrapPanel>

                            <TextBlock Text="MEASURE ANYWHERE" Style="{StaticResource PanelLabelTextStyle}" />
                            <WrapPanel Margin="6,0">
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource MeasureGapToolGeometry}" CommandParameter="MeasureGap"
                                             ToolTip="Distance between two objects (B): click one object, then the other. The dimension joins their nearest points and follows both." />
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource MeasureToolGeometry}" CommandParameter="Measure"
                                             ToolTip="Ruler (M): click two points anywhere - corners, middles, centres and edges of shapes and walls snap. Shows length, dX, dY and angle; nothing is added. Shift locks horizontal / vertical." />
                            </WrapPanel>

                            <TextBlock Text="ADD TO SELECTED SHAPE" Style="{StaticResource PanelLabelTextStyle}" />
                            <UniformGrid Columns="2" Margin="6,0,6,4">
                                <Button Content="Automatic" Tag="Auto" Click="AddDimensions_OnClick" Style="{StaticResource PanelKeyButtonStyle}"
                                        ToolTip="The dimensions that suit the shape: size, diameter, segments and angles, curve length" />
                                <Button Content="Size" Tag="Size" Click="AddDimensions_OnClick" Style="{StaticResource PanelKeyButtonStyle}"
                                        ToolTip="Width, height (and depth of a 3D box)" />
                                <Button Content="Circle" Tag="Round" Click="AddDimensions_OnClick" Style="{StaticResource PanelKeyButtonStyle}"
                                        ToolTip="Diameter and radius" />
                                <Button Content="Angles" Tag="Corners" Click="AddDimensions_OnClick" Style="{StaticResource PanelKeyButtonStyle}"
                                        ToolTip="The angle at every corner" />
                                <Button Content="Lengths" Tag="Segments" Click="AddDimensions_OnClick" Style="{StaticResource PanelKeyButtonStyle}"
                                        ToolTip="Length of every side, or of a curve" />
                            </UniformGrid>
                            <TextBlock Text="Dimensions stay attached and follow the shape. Edit unit, precision and text in the DIMENSION card."
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SHAPES" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                        <WrapPanel x:Name="ShapesWrapPanel" Margin="6,0" MinHeight="114">
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource RectangleToolGeometry}" CommandParameter="Rectangle" ToolTip="Rectangle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource RoundedRectangleToolGeometry}" CommandParameter="RoundedRectangle" ToolTip="Rounded Rectangle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource EllipseToolGeometry}" CommandParameter="Ellipse" ToolTip="Ellipse" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource TriangleToolGeometry}" CommandParameter="Triangle" ToolTip="Triangle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource DiamondToolGeometry}" CommandParameter="Diamond" ToolTip="Diamond" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource PentagonToolGeometry}" CommandParameter="Pentagon" ToolTip="Pentagon" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource HexagonToolGeometry}" CommandParameter="Hexagon" ToolTip="Hexagon" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource StarToolGeometry}" CommandParameter="Star" ToolTip="Star" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ParallelogramToolGeometry}" CommandParameter="Parallelogram" ToolTip="Parallelogram" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource TrapezoidToolGeometry}" CommandParameter="Trapezoid" ToolTip="Trapezoid" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource CrossToolGeometry}" CommandParameter="Cross" ToolTip="Cross" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource HalfCircleToolGeometry}" CommandParameter="HalfCircle" ToolTip="Half Circle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource RingToolGeometry}" CommandParameter="Ring" ToolTip="Ring" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource SpeechBubbleToolGeometry}" CommandParameter="SpeechBubble" ToolTip="Speech Bubble" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource OctagonToolGeometry}" CommandParameter="Octagon" ToolTip="Octagon" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource HeartToolGeometry}" CommandParameter="Heart" ToolTip="Heart" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource CloudToolGeometry}" CommandParameter="Cloud" ToolTip="Cloud" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ShieldToolGeometry}" CommandParameter="Shield" ToolTip="Shield" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource BookmarkToolGeometry}" CommandParameter="Bookmark" ToolTip="Bookmark" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource GearToolGeometry}" CommandParameter="Gear" ToolTip="Gear" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ClubToolGeometry}" CommandParameter="Club" ToolTip="Club" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource Box3DToolGeometry}" CommandParameter="Box3D" ToolTip="3D Box (drag the orange handle to adjust depth)" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource StarCheckToolGeometry}" CommandParameter="StarCheck" ToolTip="Star Check" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource StarPlusToolGeometry}" CommandParameter="StarPlus" ToolTip="Star Plus" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource StarMinusToolGeometry}" CommandParameter="StarMinus" ToolTip="Star Minus" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource SquareArrowOutUpRightToolGeometry}" CommandParameter="SquareArrowOutUpRight" ToolTip="Square Arrow Out" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource BlocksToolGeometry}" CommandParameter="Blocks" ToolTip="Blocks" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource SwatchBookToolGeometry}" CommandParameter="SwatchBook" ToolTip="Swatch Book" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource LensConcaveToolGeometry}" CommandParameter="LensConcave" ToolTip="Concave Lens" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource CylinderToolGeometry}" CommandParameter="Cylinder" ToolTip="Cylinder" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ConeToolGeometry}" CommandParameter="Cone" ToolTip="Cone" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource PyramidToolGeometry}" CommandParameter="Pyramid" ToolTip="Pyramid" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource TriangleAlertToolGeometry}" CommandParameter="TriangleAlert" ToolTip="Triangle Alert" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource SpadeToolGeometry}" CommandParameter="Spade" ToolTip="Spade" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource SquareDashedBottomToolGeometry}" CommandParameter="SquareDashedBottom" ToolTip="Square Dashed Bottom" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ShareToolGeometry}" CommandParameter="Share" ToolTip="Share" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ShieldCogToolGeometry}" CommandParameter="ShieldCog" ToolTip="Shield Cog" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource UmbrellaToolGeometry}" CommandParameter="Umbrella" ToolTip="Umbrella" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource CloudyToolGeometry}" CommandParameter="Cloudy" ToolTip="Cloudy" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource TrafficConeToolGeometry}" CommandParameter="TrafficCone" ToolTip="Traffic Cone" />
                        </WrapPanel>
                        <StackPanel x:Name="ShapesPagerDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESIGN GRID" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                            <WrapPanel Margin="6,0">
                                <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource GridToolGeometry}" CommandParameter="DesignGrid"
                                             ToolTip="Design Grid: drag to draw a checkered grid (2 mm squares)." />
                                <RadioButton x:Name="GridBucketRadioButton" GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                             Style="{StaticResource ShapeIconRadioButtonStyle}"
                                             Tag="{StaticResource RegionColorToolGeometry}" CommandParameter="RegionColor"
                                             ToolTip="Region Color (bucket): click or drag over the squares of a design grid to paint them with the colour below. Alt+click clears a square." />
                            </WrapPanel>

                            <TextBlock Text="PAINT COLOUR" Style="{StaticResource PanelLabelTextStyle}" />
                            <Grid Margin="10,0,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="GridPaintColorChip" Grid.Column="0" Width="28" Height="28" CornerRadius="4.5"
                                        BorderBrush="{DynamicResource InsetEdgeBrush}" BorderThickness="1" Background="#9ED9D1" />
                                <TextBlock x:Name="GridPaintColorText" Grid.Column="1" Text="#9ED9D1" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{DynamicResource ForegroundTextBrush}" FontSize="11" />
                                <Button Grid.Column="2" Content="Custom..." Style="{StaticResource PanelKeyButtonStyle}" Height="26" Margin="0"
                                        Padding="8,0" FontSize="11" Click="GridCustomColorButton_OnClick"
                                        ToolTip="Mix any colour (with transparency)" />
                                <Popup x:Name="GridColorPopup" PlacementTarget="{Binding ElementName=GridPaintColorChip}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True">
                                    <Grid Margin="0,4,8,8">
                                        <Border Background="{DynamicResource PopupSurfaceBrush}" CornerRadius="6"
                                                Effect="{DynamicResource RaisedDarkShadow}" />
                                        <Border Background="{DynamicResource PopupSurfaceBrush}" BorderBrush="{DynamicResource RaisedEdgeBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10" SnapsToDevicePixels="True">
                                            <views:ColorPickerView x:Name="GridPaintColorPicker" />
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>

                            <ItemsControl x:Name="GridPaintSwatchList" Margin="6,0,6,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="24" Height="24" Margin="3" CornerRadius="3.5" Cursor="Hand"
                                                Background="{Binding}" BorderBrush="{DynamicResource RaisedEdgeBrush}" BorderThickness="1"
                                                MouseLeftButtonDown="GridPaintSwatch_OnMouseLeftButtonDown" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Pick a colour, then click or drag over the squares. Alt+click clears a square."
                                       TextWrapping="Wrap" FontSize="10" Margin="10,2,10,4"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OBJECTS" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                        <WrapPanel x:Name="FurnitureWrapPanel" Margin="6,0" MinHeight="114">
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource DoorSingleToolGeometry}" CommandParameter="DoorSingle" ToolTip="Door (single): drag the opening, or click for a 90 cm door at the drawing scale. Lay it over a wall: it cuts the wall open." />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource DoorDoubleToolGeometry}" CommandParameter="DoorDouble" ToolTip="Double door: two leaves that meet in the middle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource WindowSingleToolGeometry}" CommandParameter="WindowSingle" ToolTip="Window: the height of the symbol is the wall thickness" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource WindowDoubleToolGeometry}" CommandParameter="WindowDouble" ToolTip="Double window: two sashes with a post in the middle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource WallOpeningToolGeometry}" CommandParameter="WallOpening" ToolTip="Wall opening: cuts the wall open without a door or window" />
                        </WrapPanel>
                        <StackPanel x:Name="FurniturePagerDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,6" />
                        <TextBlock Text="Doors and windows lie over a wall and cut it open. Drag to size them or click for a real-world size, turn them with Rotation, mirror them with Flip. Door: thickness and opening angle in the OPENING card on the right."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="12,2,12,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LINES &amp; ARROWS" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <WrapPanel Margin="6,0">
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource LineToolGeometry}" CommandParameter="Line" ToolTip="Line" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowToolGeometry}" CommandParameter="Arrow" ToolTip="Arrow" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource DoubleArrowToolGeometry}" CommandParameter="DoubleArrow" ToolTip="Double Arrow" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource PolylineToolGeometry}" CommandParameter="Polyline"
                                         ToolTip="Multi-Point Line: click each corner, double-click or Enter to finish, Escape to cancel (like AutoCAD's LINE command)" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource CurveToolGeometry}" CommandParameter="Curve" ToolTip="Curve (click to add points, double-click/Enter to finish)" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Style="{StaticResource CollapsibleCardHeaderStyle}" MouseLeftButtonDown="CardHeader_OnToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ARROWS" Style="{StaticResource CardHeaderTextStyle}" />
                            <Path Grid.Column="1" Style="{StaticResource CardChevronPathStyle}" />
                        </Grid>
                        <StackPanel>
                        <WrapPanel x:Name="ArrowsWrapPanel" Margin="6,0" MinHeight="114">
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowRightToolGeometry}" CommandParameter="ArrowRight" ToolTip="Arrow Right" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowLeftToolGeometry}" CommandParameter="ArrowLeft" ToolTip="Arrow Left" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowUpToolGeometry}" CommandParameter="ArrowUp" ToolTip="Arrow Up" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowDownToolGeometry}" CommandParameter="ArrowDown" ToolTip="Arrow Down" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ChevronRightToolGeometry}" CommandParameter="ChevronRight" ToolTip="Chevron Right" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ChevronLeftToolGeometry}" CommandParameter="ChevronLeft" ToolTip="Chevron Left" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ChevronUpToolGeometry}" CommandParameter="ChevronUp" ToolTip="Chevron Up" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ChevronDownToolGeometry}" CommandParameter="ChevronDown" ToolTip="Chevron Down" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowLeftRightToolGeometry}" CommandParameter="ArrowLeftRight" ToolTip="Arrow Left/Right" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowUpDownToolGeometry}" CommandParameter="ArrowUpDown" ToolTip="Arrow Up/Down" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource BentArrowRightToolGeometry}" CommandParameter="BentArrowRight" ToolTip="Bent Arrow Right" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource BentArrowUpToolGeometry}" CommandParameter="BentArrowUp" ToolTip="Bent Arrow Up" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource LoopArrowClockwiseToolGeometry}" CommandParameter="LoopArrowClockwise" ToolTip="Loop Clockwise" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource LoopArrowCounterClockwiseToolGeometry}" CommandParameter="LoopArrowCounterClockwise" ToolTip="Loop Counter-Clockwise" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource CompassArrowsToolGeometry}" CommandParameter="CompassArrows" ToolTip="Move (4-way)" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource NotchedArrowRightToolGeometry}" CommandParameter="NotchedArrowRight" ToolTip="Notched Arrow" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource PlayTriangleRightToolGeometry}" CommandParameter="PlayTriangleRight" ToolTip="Play" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource StripedArrowRightToolGeometry}" CommandParameter="StripedArrowRight" ToolTip="Motion Arrow" />
                        </WrapPanel>
                        <StackPanel x:Name="ArrowsPagerDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <views:IconLibraryView x:Name="IconLibrary" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
