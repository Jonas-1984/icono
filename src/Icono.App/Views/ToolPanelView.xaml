<UserControl x:Class="Icono.App.Views.ToolPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SidePanelBorderStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Tools" Style="{StaticResource PanelHeaderTextStyle}" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <WrapPanel Margin="6,0">
                        <RadioButton GroupName="ToolSelection" IsChecked="True" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource SelectToolGeometry}" CommandParameter="Select" ToolTip="Select" />
                        <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked"
                                     Style="{StaticResource ShapeIconRadioButtonStyle}"
                                     Tag="{StaticResource PanZoomToolGeometry}" CommandParameter="PanZoom" ToolTip="Pan / Zoom" />
                    </WrapPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="SHAPES" Style="{StaticResource CardHeaderTextStyle}" />
                        <WrapPanel Margin="6,0">
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource RectangleToolGeometry}" CommandParameter="Rectangle" ToolTip="Rectangle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource RoundedRectangleToolGeometry}" CommandParameter="RoundedRectangle" ToolTip="Rounded Rectangle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource EllipseToolGeometry}" CommandParameter="Ellipse" ToolTip="Ellipse" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource TriangleToolGeometry}" CommandParameter="Triangle" ToolTip="Triangle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource DiamondToolGeometry}" CommandParameter="Diamond" ToolTip="Diamond" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource PentagonToolGeometry}" CommandParameter="Pentagon" ToolTip="Pentagon" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource HexagonToolGeometry}" CommandParameter="Hexagon" ToolTip="Hexagon" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource StarToolGeometry}" CommandParameter="Star" ToolTip="Star" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ParallelogramToolGeometry}" CommandParameter="Parallelogram" ToolTip="Parallelogram" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource TrapezoidToolGeometry}" CommandParameter="Trapezoid" ToolTip="Trapezoid" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource CrossToolGeometry}" CommandParameter="Cross" ToolTip="Cross" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource HalfCircleToolGeometry}" CommandParameter="HalfCircle" ToolTip="Half Circle" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource RingToolGeometry}" CommandParameter="Ring" ToolTip="Ring" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource SpeechBubbleToolGeometry}" CommandParameter="SpeechBubble" ToolTip="Speech Bubble" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="LINES &amp; ARROWS" Style="{StaticResource CardHeaderTextStyle}" />
                        <WrapPanel Margin="6,0">
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource LineToolGeometry}" CommandParameter="Line" ToolTip="Line" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource ArrowToolGeometry}" CommandParameter="Arrow" ToolTip="Arrow" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource DoubleArrowToolGeometry}" CommandParameter="DoubleArrow" ToolTip="Double Arrow" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="OTHER" Style="{StaticResource CardHeaderTextStyle}" />
                        <WrapPanel Margin="6,0">
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource TextToolGeometry}" CommandParameter="Text" ToolTip="Text" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource BorderToolGeometry}" CommandParameter="Border" ToolTip="Border" />
                            <RadioButton GroupName="ToolSelection" Checked="ToolRadioButton_OnChecked" Style="{StaticResource ShapeIconRadioButtonStyle}"
                                         Tag="{StaticResource PaintBucketToolGeometry}" CommandParameter="PaintBucket" ToolTip="Paint Bucket" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
