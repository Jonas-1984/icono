<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
    </ResourceDictionary.MergedDictionaries>

    <!-- Shared look of every icon key: a raised graphite key at rest (gradient fill + lit rim, no shadow
         so ~100 of them stay cheap to render), a drop shadow and cyan rim on hover, and a pressed-in
         inset well with a glowing cyan glyph when it is the active tool. -->

    <!-- Tool-panel icon key: content is a Path bound via Tag to a *ToolGeometry resource. -->
    <Style x:Key="ShapeIconRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="33" />
        <Setter Property="Height" Value="33" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource RaisedEdgeBrush}" BorderThickness="1" CornerRadius="5.5">
                        <Path x:Name="Glyph" Data="{TemplateBinding Tag}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Margin="8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RaisedHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueMidBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{DynamicResource HoverGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ActiveKeyBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ActiveKeyEdgeBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Glyph" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon toggle (Bold/Italic text-format toggles): fixed 28x28 key, sinks in when checked. -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource RaisedEdgeBrush}" BorderThickness="1" CornerRadius="4.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RaisedHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueMidBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InsetBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueMidBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InsetBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon Button for the top toolbar's one-shot actions (Cut/Copy/Paste/...). -->
    <Style x:Key="ToolbarSquareIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource RaisedEdgeBrush}" BorderThickness="1" CornerRadius="5.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RaisedHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueMidBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{DynamicResource HoverGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InsetBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource InsetEdgeBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton sibling of ToolbarSquareIconButtonStyle: persistent-mode tools hosted in the top
         toolbar; the active one stays sunk in with a glowing cyan glyph. Content is a Path bound via Tag. -->
    <Style x:Key="ToolbarSquareIconRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource RaisedEdgeBrush}" BorderThickness="1" CornerRadius="5.5">
                        <Path x:Name="Glyph" Data="{TemplateBinding Tag}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Margin="8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RaisedHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueMidBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{DynamicResource HoverGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ActiveKeyBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ActiveKeyEdgeBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Glyph" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same toolbar key as above, for a raster icon (Tag holds a BitmapImage): the Border tool
         still uses Assets/Icons/border.ico rather than a hand-drawn Path. -->
    <Style x:Key="ToolbarSquareImageRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundTextBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource RaisedEdgeBrush}" BorderThickness="1" CornerRadius="5.5">
                        <!-- The raster glyph is white; using it as an opacity mask lets it take the theme foreground colour -->
                        <Rectangle x:Name="Glyph" Fill="{TemplateBinding Foreground}" Margin="8">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RaisedHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueMidBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{DynamicResource HoverGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InsetBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource InsetEdgeBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Glyph" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows-standard caption buttons (Minimize/Maximize-Restore/Close) hosted in the custom
         title bar — see TitleBarView. Flat, full-height hit area with no border/rounding,
         matching Windows 11's own caption buttons exactly. -->
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#8B0A16" />

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundTextBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionButtonPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same shape as CaptionButtonStyle but always hovers/presses red — the Close button keeps
         this look regardless of the app's accent, matching the universal OS convention. -->
    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundTextBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionClosePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same key look as ShapeIconRadioButtonStyle, but for a raster icon: Tag holds a BitmapImage
         (see Themes/ImageIcons.xaml) instead of a Geometry. -->
    <Style x:Key="ImageIconRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundTextBrush}" />
        <Setter Property="Width" Value="33" />
        <Setter Property="Height" Value="33" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource RaisedEdgeBrush}" BorderThickness="1" CornerRadius="5.5">
                        <!-- The raster glyph is white; using it as an opacity mask lets it take the theme foreground colour -->
                        <Rectangle x:Name="Glyph" Fill="{TemplateBinding Foreground}" Margin="8">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RaisedHoverBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueMidBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{DynamicResource HoverGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource InsetBrush}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource InsetEdgeBrush}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Glyph" Property="Effect" Value="{DynamicResource AccentGlowEffect}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBlueLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
