<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DARK MODE palette: warm graphite surfaces (slightly plum-tinted), cyan accent, violet glow.
         Every colour-dependent resource of the UI lives in this file and in LightPalette.xaml under
         identical keys; ThemeManager swaps the active one at runtime, and all styles reference these
         keys with DynamicResource. Key names keep the old "AccentBlue*"/"GlossyBlue*" spelling — they
         now hold the cyan ramp. -->

    <!-- ===== Base ===== -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3A3638" Offset="0.0" />
        <GradientStop Color="#FF2B2729" Offset="0.5" />
        <GradientStop Color="#FF211E20" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF302C2E" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF353133" />
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#FF1F1C1E" />
    <SolidColorBrush x:Key="BorderLineBrush" Color="#FF1B181A" />
    <SolidColorBrush x:Key="ForegroundTextBrush" Color="#FFEDEBEE" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9A959C" />

    <!-- ===== Accent (cyan) ===== -->
    <SolidColorBrush x:Key="AccentBlueMidBrush" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#FF6AEAFA" />
    <SolidColorBrush x:Key="AccentBlueDarkBrush" Color="#FF0E7C90" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="#FFA45CF5" />

    <LinearGradientBrush x:Key="GlossyBlueBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6AEAFA" Offset="0.0" />
        <GradientStop Color="#FF22D3EE" Offset="0.45" />
        <GradientStop Color="#FF0E7C90" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossyBlueBrushHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF1AA9C0" Offset="0.0" />
        <GradientStop Color="#FF22D3EE" Offset="0.7" />
        <GradientStop Color="#FF6AEAFA" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossHighlightOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="SoftAccentGlowBrush" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#4022D3EE" Offset="0.0" />
        <GradientStop Color="#1A22D3EE" Offset="0.7" />
        <GradientStop Color="#0022D3EE" Offset="1.0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SoftAccentHoverBrush" Color="#3322D3EE" />
    <SolidColorBrush x:Key="ToolIconHoverBrush" Color="#2222D3EE" />

    <LinearGradientBrush x:Key="WindowEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9922D3EE" Offset="0.0" />
        <GradientStop Color="#33FFFFFF" Offset="0.5" />
        <GradientStop Color="#99A45CF5" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ===== Neumorphic surfaces ===== -->
    <LinearGradientBrush x:Key="PanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3D383A" Offset="0.0" />
        <GradientStop Color="#FF2F2B2D" Offset="0.6" />
        <GradientStop Color="#FF282426" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF433E40" Offset="0.0" />
        <GradientStop Color="#FF2E2A2C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4C4749" Offset="0.0" />
        <GradientStop Color="#FF35302F" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5A5456" Offset="0.0" />
        <GradientStop Color="#FF2A2628" Offset="0.5" />
        <GradientStop Color="#FF151214" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InsetBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1D1A1C" Offset="0.0" />
        <GradientStop Color="#FF2A2628" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF121011" Offset="0.0" />
        <GradientStop Color="#FF2B2729" Offset="0.5" />
        <GradientStop Color="#FF48433F" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Active (selected) tool key: sunk-in well in the dark theme -->
    <LinearGradientBrush x:Key="ActiveKeyBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1D1A1C" Offset="0.0" />
        <GradientStop Color="#FF2A2628" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActiveKeyEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF121011" Offset="0.0" />
        <GradientStop Color="#FF2B2729" Offset="0.5" />
        <GradientStop Color="#FF48433F" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Window caption buttons -->
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#33FFFFFF" />

    <!-- ===== Shadows / glows (light source top-left) ===== -->
    <DropShadowEffect x:Key="RaisedDarkShadow" Color="#FF0E0C0D" BlurRadius="12" ShadowDepth="4" Direction="315" Opacity="0.75" />
    <DropShadowEffect x:Key="RaisedLightShadow" Color="#FF55504F" BlurRadius="12" ShadowDepth="4" Direction="135" Opacity="0.35" />
    <DropShadowEffect x:Key="SmallRaisedShadow" Color="#FF0E0C0D" BlurRadius="6" ShadowDepth="2.5" Direction="315" Opacity="0.7" />
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#FF22D3EE" BlurRadius="10" ShadowDepth="0" Opacity="0.85" />
    <DropShadowEffect x:Key="VioletGlowEffect" Color="#FFA45CF5" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />

</ResourceDictionary>
