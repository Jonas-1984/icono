<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Anthracite base palette -->
    <Color x:Key="WindowBackgroundColor">#FF2B2B2B</Color>
    <Color x:Key="PanelBackgroundColor">#FF323232</Color>
    <Color x:Key="ToolbarBackgroundColor">#FF3C3C3C</Color>
    <Color x:Key="CanvasSurroundColor">#FF262626</Color>
    <Color x:Key="BorderLineColor">#FF1E1E1E</Color>
    <Color x:Key="ForegroundTextColor">#FFE6E6E6</Color>
    <Color x:Key="MutedTextColor">#FFA0A0A0</Color>

    <!-- Glossy blue accent ramp -->
    <Color x:Key="AccentBlueLightColor">#FF6FB1FF</Color>
    <Color x:Key="AccentBlueMidColor">#FF2E86FF</Color>
    <Color x:Key="AccentBlueDarkColor">#FF1B4F91</Color>
    <Color x:Key="AccentBlueHighlightColor">#FFDCEBFF</Color>

</ResourceDictionary>
