<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme-independent brushes only. Everything that changes between Dark/Light mode lives in
         DarkPalette.xaml / LightPalette.xaml and is referenced with DynamicResource. -->

    <!-- A real blue for the user-facing "Blue Gloss" shape-fill preset (must NOT follow the UI accent) -->
    <LinearGradientBrush x:Key="BlueGlossPresetBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6FB1FF" Offset="0.0" />
        <GradientStop Color="#FF2E86FF" Offset="0.45" />
        <GradientStop Color="#FF1B4F91" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Rainbow hue strip for the color picker -->
    <LinearGradientBrush x:Key="RainbowHueBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF0000" Offset="0.0" />
        <GradientStop Color="#FFFF9900" Offset="0.1667" />
        <GradientStop Color="#FFFFFF00" Offset="0.3333" />
        <GradientStop Color="#FF00FF00" Offset="0.5" />
        <GradientStop Color="#FF00FFFF" Offset="0.6667" />
        <GradientStop Color="#FF0000FF" Offset="0.8333" />
        <GradientStop Color="#FFFF00FF" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
