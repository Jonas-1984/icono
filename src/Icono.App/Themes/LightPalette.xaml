<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LIGHT MODE — "Premium": white stage, light-blue accent. Same design mix as the dark palette
         (~70 % neumorphism, ~20 % glassmorphism, ~10 % fluent), same keys as DarkPalette.xaml. -->

    <!-- ===== Stage ===== -->
    <!-- White with a soft blue light (top-left) and a lilac light (bottom-right) for the glass to pick up. -->
    <DrawingBrush x:Key="WindowBackgroundBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 L100,0 L100,100 L0,100 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                            <GradientStop Color="#FFF0F3F8" Offset="0.55" />
                            <GradientStop Color="#FFE2E8F1" Offset="1.0" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L100,0 L100,100 L0,100 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.08,0.02" GradientOrigin="0.08,0.02" RadiusX="0.75" RadiusY="0.7">
                            <GradientStop Color="#66A9D3FF" Offset="0.0" />
                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L100,0 L100,100 L0,100 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.98,1" GradientOrigin="0.98,1" RadiusX="0.7" RadiusY="0.65">
                            <GradientStop Color="#55C9BEFF" Offset="0.0" />
                            <GradientStop Color="#00FFFFFF" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFEDF1F7" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFF1F4F9" />
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#FFD3DAE6" />
    <SolidColorBrush x:Key="BorderLineBrush" Color="#FFB7C0D0" />
    <SolidColorBrush x:Key="ForegroundTextBrush" Color="#FF1B2332" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF67748A" />

    <!-- ===== Accent (light blue, a notch deeper so it reads on white) ===== -->
    <SolidColorBrush x:Key="AccentBlueMidBrush" Color="#FF2F8FE8" />
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#FF5AB0FF" />
    <SolidColorBrush x:Key="AccentBlueDarkBrush" Color="#FF1F5FA6" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="#FF7C6BFF" />

    <LinearGradientBrush x:Key="GlossyBlueBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF8CCBFF" Offset="0.0" />
        <GradientStop Color="#FF2F8FE8" Offset="0.45" />
        <GradientStop Color="#FF1F5FA6" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossyBlueBrushHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF1F78D0" Offset="0.0" />
        <GradientStop Color="#FF2F8FE8" Offset="0.7" />
        <GradientStop Color="#FF8CCBFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossHighlightOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="SoftAccentGlowBrush" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#402F8FE8" Offset="0.0" />
        <GradientStop Color="#1A2F8FE8" Offset="0.7" />
        <GradientStop Color="#002F8FE8" Offset="1.0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SoftAccentHoverBrush" Color="#302F8FE8" />
    <SolidColorBrush x:Key="ToolIconHoverBrush" Color="#202F8FE8" />

    <LinearGradientBrush x:Key="WindowEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#AA5AB0FF" Offset="0.0" />
        <GradientStop Color="#77FFFFFF" Offset="0.5" />
        <GradientStop Color="#889E8CFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ===== Glass (panels, toolbar, popups) ===== -->
    <LinearGradientBrush x:Key="PanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0.0" />
        <GradientStop Color="#E6F6F9FD" Offset="0.3" />
        <GradientStop Color="#E0ECF1F8" Offset="0.7" />
        <GradientStop Color="#E6E1E8F2" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Drop-downs, context menus and tooltips: the glass look, but opaque enough to stay readable over the page -->
    <LinearGradientBrush x:Key="PopupSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#FFF2F5FA" Offset="0.6" />
        <GradientStop Color="#FFE8EDF5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0.0" />
        <GradientStop Color="#C8F1F5FB" Offset="0.5" />
        <GradientStop Color="#CCE4EAF3" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#99C9DAF2" Offset="0.3" />
        <GradientStop Color="#66B7C3D8" Offset="0.65" />
        <GradientStop Color="#889E8CFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ===== Neumorphic keys and wells ===== -->
    <LinearGradientBrush x:Key="RaisedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#FFE4E9F1" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#FFF1F5FB" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#FFDCE2EC" Offset="0.5" />
        <GradientStop Color="#FFAFB8C9" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InsetBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD3DAE6" Offset="0.0" />
        <GradientStop Color="#FFEDF1F7" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB1BACB" Offset="0.0" />
        <GradientStop Color="#FFE3E8F0" Offset="0.5" />
        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Active tool key: a dark round knob with a blue-lit rim, like the premium dark keys -->
    <LinearGradientBrush x:Key="ActiveKeyBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3B4252" Offset="0.0" />
        <GradientStop Color="#FF191D27" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActiveKeyEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5F6B82" Offset="0.0" />
        <GradientStop Color="#FF222735" Offset="0.5" />
        <GradientStop Color="#FF4C93D8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Window caption buttons -->
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#24000000" />

    <!-- Glass-theme keys that the soft themes leave empty: the veil over a hovered key and the second layer of an icon -->
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#00FFFFFF" />
    <x:Null x:Key="GlyphLayerEffect" />

    <!-- ===== Shadows / glows ===== -->
    <DropShadowEffect x:Key="RaisedDarkShadow" Color="#FF8E9BB3" BlurRadius="16" ShadowDepth="5" Direction="315" Opacity="0.5" />
    <DropShadowEffect x:Key="RaisedLightShadow" Color="#FFFFFFFF" BlurRadius="16" ShadowDepth="5" Direction="135" Opacity="1" />
    <DropShadowEffect x:Key="SmallRaisedShadow" Color="#FF8E9BB3" BlurRadius="8" ShadowDepth="3" Direction="315" Opacity="0.55" />
    <DropShadowEffect x:Key="HoverGlowEffect" Color="#FF3E9BF0" BlurRadius="12" ShadowDepth="0" Opacity="0.4" />
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#FF5AB0FF" BlurRadius="10" ShadowDepth="0" Opacity="0.85" />
    <DropShadowEffect x:Key="VioletGlowEffect" Color="#FF7C6BFF" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />

</ResourceDictionary>
