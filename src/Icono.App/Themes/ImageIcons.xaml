<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- User-supplied raster icons (Assets/Icons/*.ico) — filled white glyphs, distinct in style
         from the hand-drawn stroke-only ShapeIcons.xaml vector set. Referenced from Image
         controls directly, and from ImageIconRadioButtonStyle's Tag for tool-palette buttons. -->
    <BitmapImage x:Key="TextIconImage" UriSource="pack://application:,,,/Assets/Icons/text.ico" />
    <BitmapImage x:Key="BorderIconImage" UriSource="pack://application:,,,/Assets/Icons/border.ico" />

</ResourceDictionary>
