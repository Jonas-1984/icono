<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GLASS LIGHT - "Liquid Glass" in the light: a pastel aurora behind white, frosted panes. Same keys as DarkPalette.xaml. -->

    <!-- ===== Stage: pastel blue / lilac / mint ===== -->
    <DrawingBrush x:Key="WindowBackgroundBrush" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 L100,0 L100,100 L0,100 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C0DCEBFF" Offset="0.0" />
                            <GradientStop Color="#C0EADFFF" Offset="0.5" />
                            <GradientStop Color="#C0D9F5EE" Offset="1.0" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L100,0 L100,100 L0,100 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.1,0.05" GradientOrigin="0.1,0.05" RadiusX="0.7" RadiusY="0.65">
                            <GradientStop Color="#AA7CC0FF" Offset="0.0" />
                            <GradientStop Color="#007CC0FF" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L100,0 L100,100 L0,100 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.95,0.95" GradientOrigin="0.95,0.95" RadiusX="0.65" RadiusY="0.6">
                            <GradientStop Color="#99FFB8E0" Offset="0.0" />
                            <GradientStop Color="#00FFB8E0" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 L100,0 L100,100 L0,100 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.1,0.95" GradientOrigin="0.1,0.95" RadiusX="0.5" RadiusY="0.45">
                            <GradientStop Color="#8890EBD0" Offset="0.0" />
                            <GradientStop Color="#0090EBD0" Offset="1.0" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFEAF1FD" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFF0F5FF" />
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#66C5D2EA" />
    <SolidColorBrush x:Key="BorderLineBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ForegroundTextBrush" Color="#FF1B2238" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF5F6A8A" />

    <!-- ===== Accent (system blue) ===== -->
    <SolidColorBrush x:Key="AccentBlueMidBrush" Color="#FF0A7AFF" />
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#FF0A62D8" />
    <SolidColorBrush x:Key="AccentBlueDarkBrush" Color="#FF0A55C0" />
    <SolidColorBrush x:Key="AccentVioletBrush" Color="#FF7C5CFF" />

    <LinearGradientBrush x:Key="GlossyBlueBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF7CC4FF" Offset="0.0" />
        <GradientStop Color="#FF0A7AFF" Offset="0.45" />
        <GradientStop Color="#FF0A55C0" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossyBlueBrushHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0A62D8" Offset="0.0" />
        <GradientStop Color="#FF0A7AFF" Offset="0.7" />
        <GradientStop Color="#FF7CC4FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossHighlightOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="SoftAccentGlowBrush" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#440A7AFF" Offset="0.0" />
        <GradientStop Color="#190A7AFF" Offset="0.7" />
        <GradientStop Color="#000A7AFF" Offset="1.0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SoftAccentHoverBrush" Color="#330A7AFF" />
    <SolidColorBrush x:Key="ToolIconHoverBrush" Color="#260A7AFF" />

    <LinearGradientBrush x:Key="WindowEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#88FFFFFF" Offset="0.4" />
        <GradientStop Color="#33FFFFFF" Offset="0.7" />
        <GradientStop Color="#66A9B6D8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ===== Panes: frosted white ===== -->
    <LinearGradientBrush x:Key="PanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C7FFFFFF" Offset="0.0" />
        <GradientStop Color="#99FFFFFF" Offset="0.3" />
        <GradientStop Color="#85FFFFFF" Offset="0.7" />
        <GradientStop Color="#A6FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PopupSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0.0" />
        <GradientStop Color="#DEF6F9FF" Offset="0.6" />
        <GradientStop Color="#DEEEF3FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0.0" />
        <GradientStop Color="#99FFFFFF" Offset="0.5" />
        <GradientStop Color="#B3FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#99FFFFFF" Offset="0.3" />
        <GradientStop Color="#40FFFFFF" Offset="0.6" />
        <GradientStop Color="#66A9B6D8" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ===== Glass keys ===== -->
    <LinearGradientBrush x:Key="RaisedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0.0" />
        <GradientStop Color="#B8FFFFFF" Offset="0.49" />
        <GradientStop Color="#99F2F6FF" Offset="0.51" />
        <GradientStop Color="#B3FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#E6FFFFFF" Offset="0.49" />
        <GradientStop Color="#CCF6F9FF" Offset="0.51" />
        <GradientStop Color="#E6FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#99FFFFFF" Offset="0.4" />
        <GradientStop Color="#33A9B6D8" Offset="0.6" />
        <GradientStop Color="#66A9B6D8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InsetBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26283C78" Offset="0.0" />
        <GradientStop Color="#14283C78" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="InsetEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40283C78" Offset="0.0" />
        <GradientStop Color="#33FFFFFF" Offset="0.5" />
        <GradientStop Color="#99FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActiveKeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0.0" />
        <GradientStop Color="#99B8DCFF" Offset="0.5" />
        <GradientStop Color="#B38CC8FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActiveKeyEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#990A7AFF" Offset="0.5" />
        <GradientStop Color="#FF5AB4FF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#55FFFFFF" />

    <SolidColorBrush x:Key="GlassHoverBrush" Color="#66FFFFFF" />

    <!-- ===== Depth: airy, bluish shadows ===== -->
    <DropShadowEffect x:Key="RaisedDarkShadow" Color="#FF2A3C78" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.22" />
    <DropShadowEffect x:Key="RaisedLightShadow" Color="#FFFFFFFF" BlurRadius="14" ShadowDepth="0" Direction="135" Opacity="0.35" />
    <DropShadowEffect x:Key="SmallRaisedShadow" Color="#FF2A3C78" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.22" />
    <DropShadowEffect x:Key="HoverGlowEffect" Color="#FF0A7AFF" BlurRadius="14" ShadowDepth="0" Opacity="0.4" />
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#FF0A7AFF" BlurRadius="9" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="VioletGlowEffect" Color="#FF7C5CFF" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />

    <DropShadowEffect x:Key="GlyphLayerEffect" Color="#FF2A3C78" BlurRadius="3" ShadowDepth="1.5" Direction="270" Opacity="0.28" />

</ResourceDictionary>
