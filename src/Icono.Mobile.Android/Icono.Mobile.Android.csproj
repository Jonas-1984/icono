<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Android app (APK) around Icono.Mobile. Build and put it on the tablet with tools\deploy-android.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>de.bitbins.icono</ApplicationId>
    <ApplicationTitle>icono</ApplicationTitle>
    <!-- ApplicationVersion must grow with every APK handed out (Android only installs an update with a higher number) -->
    <ApplicationVersion>30</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-test.30</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- the app is installed with "adb install"; fast deployment (assemblies pushed separately) does not work on the Xiaomi tablet -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- The APK handed to testers (tools\build-android-release.ps1 signs it with the key that lives outside the repository). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- 64- and 32-bit ARM: every tablet of the last years, and a smaller APK than with the x86 emulator parts -->
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <!-- drawings are read and written with System.Text.Json by reflection; a trimmed app switches that off unless it is asked for -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- only the framework is trimmed, never icono's own code (the drawing classes are read by reflection) -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <!-- handwriting to text: recognizes on the tablet; the language model (about 20 MB) is loaded once -->
    <PackageReference Include="Xamarin.Google.MLKit.DigitalInk.Recognition" Version="119.0.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Icono.Mobile\Icono.Mobile.csproj" />
  </ItemGroup>

</Project>
