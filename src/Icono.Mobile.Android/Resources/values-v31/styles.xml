<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <!-- Android 12+: the system start screen shows the icono icon on the dark surround colour -->
  <style name="IconoTheme.NoActionBar" parent="@style/Theme.AppCompat.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/splash_background</item>
    <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/icon</item>
  </style>
</resources>
