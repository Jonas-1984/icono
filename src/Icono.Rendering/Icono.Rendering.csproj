<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Icono.Core\Icono.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The Sinks, Appliances, Cooktops and Workplace catalogues come from CAD exports whose origin is not documented yet: they stay out of the builds handed to other
       people (Release) until the licence of the drawings is clear. Remove this line to ship it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);EXCLUDE_UNVERIFIED_CATALOGUES</DefineConstants>
  </PropertyGroup>

</Project>
