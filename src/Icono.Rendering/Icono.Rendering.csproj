<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Icono.Core\Icono.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The Sinks, Appliances, Cooktops and Workplace catalogues come from CAD exports whose origin is not documented yet: they stay out of the
       builds handed to other people (Release) until the licence of the drawings is clear. Build with -p:ExcludeUnverifiedCatalogues=false
       (installer\build-installer.ps1 -IncludeLocalCatalogues) to ship them anyway. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(ExcludeUnverifiedCatalogues)' != 'false'">
    <DefineConstants>$(DefineConstants);EXCLUDE_UNVERIFIED_CATALOGUES</DefineConstants>
  </PropertyGroup>

  <!-- ... and their drawing data is not even compiled in, so it cannot be read out of the DLL of such a build. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release' And '$(ExcludeUnverifiedCatalogues)' != 'false'">
    <Compile Remove="UnitCatalog.Local.cs;UnitCatalog.Local.*.Generated.cs" />
  </ItemGroup>

</Project>
